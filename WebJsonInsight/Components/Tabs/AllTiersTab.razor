@*
    All tiers — one row per configuration path, one column per source.

    A subtree missing wholesale from the same tiers collapses to a single row
    ("AccountSettings:NightlyApprovalJob — 11 keys, only in dev"), and that rolled-up node is exactly
    what Promote acts on. Identical rows are hidden by default; deployment-specific differences are
    shown separately so a misclassified key can never quietly vanish.

    The columns are generated from Diff.TierIds at render time, so adding a source grows a column with
    no change here.
*@
@inherits ObservingComponent<TiersVm>
@inject DialogService Dialogs

@if (Vm is null)
{
    <div class="empty">No project is open.</div>
}
else
{
    <div class="tiers">

        @* ------------------------------- Section rail -------------------------------- *@
        <aside class="tiers-rail">
            <div class="card card-flush rail-card">
                <div class="card-head">
                    <span class="section-label">SECTIONS</span>
                    <button class="btn btn-small" @onclick="() => Vm.ClearSectionCommand.Execute(null)"
                            title="Clear the section filter">all</button>
                </div>

                <div class="rail-list">
                    @foreach (var section in Vm.Sections)
                    {
                        <button class="rail-item @(section.Name == Vm.SectionFilter ? "selected" : "")"
                                @key="section.Name"
                                @onclick="() => Vm.SectionFilter = section.Name"
                                title="@section.Counts">
                            <div class="rail-name">@section.Name</div>

                            @* Three parts, three colours: the key count is neutral, missing keys take
                               the grid's red and differing ones its orange. One string could only
                               carry one colour, so the rail could only be read line by line rather
                               than scanned for one. *@
                            <div class="rail-counts">
                                <span>@section.KeysLabel</span>
                                @if (section.HasMissing)
                                {
                                    <span class="rail-missing">@section.MissingLabel</span>
                                }
                                @if (section.HasDiffering)
                                {
                                    <span class="rail-differing">@section.DifferingLabel</span>
                                }
                            </div>
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Vm.PullStatus))
            {
                @* Under the rail rather than in a popup: "identical, skipped" is the normal answer and
                   wants to stay readable while you look at the grid. *@
                <div class="card">
                    <div class="section-label">LAST PULL</div>
                    <p class="caption">@Vm.PullStatus</p>
                    @foreach (var line in Vm.PullReport)
                    {
                        <div class="pull-line">@line</div>
                    }
                </div>
            }
        </aside>

        @* ---------------------------------- Main ------------------------------------- *@
        <div class="tiers-main">

            <div class="card tiers-toolbar">
                <SearchBox Value="@Vm.Filter"
                           ValueChanged="v => Vm.Filter = v"
                           Placeholder="Filter by path — or a glob, e.g. ConnectionStrings:*:Url" />

                <div class="toolbar-row">
                    @* A switch rather than a checkbox: it is a state you leave on while working
                       through the differences, same as the Find switch on the Tier editor. *@
                    <button class="switch @(Vm.OnlyChanges ? "on" : "")"
                            @onclick="() => Vm.OnlyChanges = !Vm.OnlyChanges"
                            title="Hide every row the sources agree on. Keys with unwritten edits stay visible either way.">
                        <span class="switch-track"><span class="switch-knob"></span></span>
                        <span>Only changed values</span>
                    </button>
                    <label class="check">
                        <input type="checkbox" checked="@Vm.ShowExpected"
                               @onchange="e => Vm.ShowExpected = (bool?)e.Value ?? false" />
                        <span>Show expected (deployment-specific)</span>
                    </label>
                    <button class="btn btn-small" @onclick="() => Vm.ExpandAllCommand.Execute(null)">Expand all</button>
                    <button class="btn btn-small" @onclick="() => Vm.CollapseAllCommand.Execute(null)">Collapse all</button>
                    <span class="caption inline">@Vm.ShownLabel</span>
                </div>

                @* Nothing pushes from here. The title bar's push button is the single way in: it
                   opens the review of everything unwritten, which is where the tier is chosen and
                   where a batch spanning several tiers is sent one tier at a time. A second way in
                   is a second thing to keep in step with it. *@
                <div class="toolbar-row">
                    <span class="pill pill-quiet">@Vm.SourceLabel</span>
                </div>

                @if (Vm.HasPendingEdits)
                {
                    @* Loud on purpose: an unwritten change set is easy to walk away from, and the
                       whole point of batching is that it sits there until reviewed as a whole. *@
                    <div class="pending-bar">
                        <span class="pending-text">@Vm.PendingLabel</span>
                        <button class="btn btn-primary" @onclick="() => Dialogs.OpenChanges()">Review and write</button>
                    </div>
                }
            </div>

            <div class="card card-flush grid-card">
                <div class="grid-scroll">
                    <table class="grid">
                        <thead>
                            <tr>
                                <th class="col-path">PATH</th>
                                @foreach (var tierId in Vm.Diff.TierIds)
                                {
                                    var reason = Vm.UnavailableReason(tierId);
                                    <th class="col-tier @(reason is null ? "" : "unavailable")"
                                        title="@(reason ?? SourceDetailOf(tierId))">
                                        <div class="th-name">@tierId</div>
                                        <div class="th-sub">@(reason is null ? SourceOf(tierId) : "UNAVAILABLE")</div>
                                        @* A row of its own rather than the end of the line above: the age is
                                           what gets read while scanning four columns, and appending it would
                                           bury it at the end of the line most likely to be trimmed. *@
                                        @if (reason is null && AgeOf(tierId) is { Length: > 0 } age)
                                        {
                                            <div class="th-age">@age</div>
                                        }
                                    </th>
                                }
                                <th class="col-actions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Vm.Rows)
                            {
                                <tr class="@RowClass(row)" @key="row.Path"
                                    @onclick="() => Vm.SelectedRow = row">

                                    <td class="col-path">
                                        <div class="path-cell" style="padding-left:@(row.Depth * 14)px">
                                            @if (row.IsGroup)
                                            {
                                                <button class="twisty" @onclick:stopPropagation="true"
                                                        @onclick="() => Toggle(row)">
                                                    <Icon Name="@(row.IsExpanded ? "chevron-down" : "chevron-right")" Size="12" />
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="twisty-spacer"></span>
                                            }

                                            <span class="path-label">@row.Label</span>

                                            @if (!string.IsNullOrEmpty(row.Summary))
                                            {
                                                <span class="path-summary">@row.Summary</span>
                                            }

                                            @if (row.HasPendingEdit)
                                            {
                                                <span class="pending-dot" title="This key has been changed in memory and not yet written to its source">●</span>
                                            }
                                        </div>
                                    </td>

                                    @foreach (var cell in row.Cells)
                                    {
                                        <td class="col-tier cell-@cell.State.ToString().ToLowerInvariant() @VarianceClass(cell) @(row.IsSecret ? "cell-secret" : "")"
                                            title="@CellTitle(cell)">@cell.Display</td>
                                    }

                                    @* Editing starts from the row rather than from a toolbar button,
                                       because a button acting on "whatever is selected" is the one
                                       that eventually gets pressed against the wrong row. *@
                                    <td class="col-actions" @onclick:stopPropagation="true">
                                        @if (row.CanEdit)
                                        {
                                            <button class="btn btn-small" @onclick="() => Dialogs.OpenEdit(row.LeafPaths)"
                                                    title="Change or remove this key across the tiers.">Edit</button>
                                        }
                                        @if (row.CanPromote)
                                        {
                                            <button class="btn btn-small" @onclick="() => Dialogs.OpenPromote(row)"
                                                    title="Copy this subtree into a tier that does not have it.">Promote →</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (Vm.Rows.Count == 0)
                    {
                        <div class="grid-empty">
                            @(string.IsNullOrEmpty(Vm.Filter) && Vm.SectionFilter is null
                                ? "Nothing to compare yet — pull the sources, or tick some on the Sources tab."
                                : "Nothing matches. Rows the sources agree on are hidden while Only changed values is on.")
                        </div>
                    }
                </div>
            </div>

            @if (Vm.SelectedRow is { } selected)
            {
                <div class="card detail-strip">
                    <div class="detail-path">@selected.Path</div>
                    @if (!string.IsNullOrEmpty(selected.Detail))
                    {
                        <div class="detail-note">@selected.Detail</div>
                    }
                    @if (selected.IsSecret)
                    {
                        <div class="detail-secret">
                            <Icon Name="vault" Size="12" />
                            <span>
                                Secret — the value is never shown. The short hash lets you tell whether
                                two tiers hold the same secret.
                            </span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    protected override void ObserveAlso(TiersVm? vm)
    {
        // DocumentsChanged fires when a pull replaces the whole document set, which changes the
        // columns rather than the rows - the header is built from Diff.TierIds and would otherwise
        // keep claiming the previous set.
        if (vm is not null)
        {
            vm.DocumentsChanged += OnDocumentsChanged;
        }

        Observe(vm?.Rows, vm?.Sections, vm?.PullReport);
    }

    protected override void StopObservingAlso(TiersVm? vm)
    {
        if (vm is not null)
        {
            vm.DocumentsChanged -= OnDocumentsChanged;
        }
    }

    private void OnDocumentsChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    protected override void Disposing() => StopObservingAlso(Observed);

    /// <summary>
    /// A rollup toggles its own children; an ordinary group collapses. Which one this row is, is the
    /// view model's to know — see <see cref="TiersVm.ToggleAny"/>.
    /// </summary>
    private void Toggle(TierRowVm row) => Vm?.ToggleAny(row);

    private string RowClass(TierRowVm row)
    {
        var classes = new List<string>(3);

        if (row.IsGroup)
        {
            classes.Add("is-group");
        }

        if (row.HasPendingEdit)
        {
            classes.Add("has-pending");
        }

        if (ReferenceEquals(row, Vm?.SelectedRow))
        {
            classes.Add("selected");
        }

        return string.Join(' ', classes);
    }

    /// <summary>
    /// Which version of what a column is showing. The number is the point: it is the difference
    /// between "stage does not have this key" and "stage did not have it an hour ago", and this
    /// header used to say only "Vault".
    /// </summary>
    private string SourceOf(string tierId) => Document(tierId)?.SourceBadge ?? string.Empty;

    /// <summary>The longer form — the server, the secret and the version — for the header's tooltip.</summary>
    private string SourceDetailOf(string tierId) => Document(tierId)?.SourceDetail ?? string.Empty;

    /// <summary>How old what this column holds is — "11 h 23 min ago". Empty when it has no timestamp.</summary>
    private string AgeOf(string tierId) => Document(tierId)?.SourceAge ?? string.Empty;

    private TierDocument? Document(string tierId) =>
        Vm?.Documents.FirstOrDefault(d => d.Id.Equals(tierId, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// The full value on hover — except for a secret, which is never rendered anywhere but the Tier
    /// editor's text pane, and an unavailable cell, where the honest tooltip is why it could not be
    /// read rather than a value nobody has.
    /// </summary>
    private string CellTitle(MultiCell cell) => cell.State == CellState.Unavailable
        ? Vm?.UnavailableReason(cell.TierId) ?? cell.Tooltip
        : cell.Tooltip;

    /// <summary>Present everywhere and not equal — the colouring the WPF cell template does with triggers.</summary>
    private static string VarianceClass(MultiCell cell) => cell.Variance switch
    {
        CellVariance.Drift => "cell-drift",
        CellVariance.Expected => "cell-drift-expected",
        _ => string.Empty,
    };
}
