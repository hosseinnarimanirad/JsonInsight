@*
    Tier editor — one tier's whole document, as a searchable hierarchy on the left and replaceable
    JSON text on the right.

    The escape hatch for changes the key-by-key editor cannot express: restructuring a section,
    pasting in a block someone sent you, retyping a subtree wholesale.

    Two behaviours here are load-bearing and easy to lose in a port:

      * A single value is applied AS YOU TYPE, a section is not. JsonEditorVm decides which by
        SelectedIsScalar; this component just forwards every keystroke to EditorText and lets the view
        model do the rest. Text that does not parse yet is not an error - it is a value on its way in.

      * The tree is RE-MARKED IN PLACE rather than rebuilt. That is the view model's doing too, and it
        is why the caret survives a keystroke. The @key on each row is what keeps Blazor from throwing
        the <textarea> away and taking the caret with it.
*@
@inherits ObservingComponent<JsonEditorVm>
@inject IJSRuntime Js
@inject DialogService Dialogs

@if (Vm is null)
{
    <div class="empty">No project is open.</div>
}
else
{
    <div class="editor">

        @* ------------------------------- Toolbar --------------------------------- *@
        <div class="card editor-toolbar">
            <div class="toolbar-row">
                <label for="ed-tier">Tier</label>

                @* The version is in the list rather than beside it: which version you are about to
                   edit is part of choosing what to edit, since an edit is built against one and a
                   push is refused when somebody has replaced it since. *@
                <select id="ed-tier" class="field" value="@Vm.Tier?.Id"
                        title="@(Vm.Tier?.SourceDetail ?? "Which source to edit, and which version of it is loaded.")"
                        @onchange="e => Vm.Tier = Vm.Tiers.FirstOrDefault(t => t.Id == e.Value?.ToString())">
                    @foreach (var tier in Vm.Tiers)
                    {
                        <option value="@tier.Id" selected="@(tier.Id == Vm.Tier?.Id)">@tier.PickerLabel</option>
                    }
                </select>

                <button class="btn btn-small" disabled="@(!Vm.CanUndo)"
                        @onclick="() => Vm.UndoCommand.Execute(null)" title="Undo (Ctrl+Z)">
                    <Icon Name="undo" Size="13" /> <span>Undo</span>
                </button>
                <button class="btn btn-small" disabled="@(!Vm.CanRedo)"
                        @onclick="() => Vm.RedoCommand.Execute(null)" title="Redo (Ctrl+Y)">
                    <Icon Name="redo" Size="13" /> <span>Redo</span>
                </button>
                <button class="btn btn-small" disabled="@(!Vm.IsModified)"
                        @onclick="() => Vm.RevertAllCommand.Execute(null)"
                        title="Back to the state this tier was opened in. Itself undoable.">
                    Revert all
                </button>

                <button class="btn btn-small @(Vm.ShowingComparison ? "toggled" : "")"
                        disabled="@(!Vm.CanCompare)"
                        @onclick="() => Vm.ToggleComparisonCommand.Execute(null)"
                        title="Swap the pane for a diff against the state this tier was opened in, scoped to the selection.">
                    Compare with original
                </button>

                @* A switch rather than a button, matching Changed on the tree and Compact/Wrap below:
                   the find bar is a state you leave on, and Ctrl+F was the only way to reach it —
                   a shortcut is not a control, and nothing on screen said the bar existed. *@
                <button class="switch @(Vm.FindOpen ? "on" : "")" disabled="@Vm.ShowingComparison"
                        @onclick="() => Vm.ToggleFindCommand.Execute(null)"
                        title="Find and replace over the pane (Ctrl+F). Every match is highlighted; Enter and Shift+Enter step through them.">
                    <span class="switch-track"><span class="switch-knob"></span></span>
                    <span>Find</span>
                </button>

                <span class="spacer"></span>

                @* The only way an edit leaves this window. There is no Save, because there is nowhere
                   to save to. This tab is looking at exactly one tier, so it passes that one rather
                   than letting the push screen offer a picker. *@
                @* CanPush, not CanEdit: a writable tier with nothing changed has nothing to push, and
                   the WPF button has always been greyed out for it. *@
                <button class="btn btn-small btn-danger" disabled="@(!Vm.CanPush)"
                        @onclick="OpenPush" title="@Vm.PushHint">
                    <Icon Name="push" Size="13" /> <span>Push to Vault or disk…</span>
                </button>
            </div>

            @if (!Vm.CanEdit && !string.IsNullOrEmpty(Vm.ReadOnlyReason))
            {
                <div class="notice notice-warn"><Icon Name="warn" /> <span>@Vm.ReadOnlyReason</span></div>
            }

            @if (!string.IsNullOrEmpty(Vm.Error))
            {
                <div class="notice notice-danger"><Icon Name="warn" /> <span>@Vm.Error</span></div>
            }
            else if (!string.IsNullOrEmpty(Vm.Message))
            {
                <div class="notice notice-ok"><Icon Name="ok" /> <span>@Vm.Message</span></div>
            }
        </div>

        <div class="editor-body">

            @* ------------------------------ Hierarchy ----------------------------- *@
            <div class="card card-flush editor-tree">
                <div class="tree-filter">
                    @* A switch rather than a tick box: it is a mode you leave on, and one left on is
                       why the tree looks half empty an hour later. It sits in FRONT of the search box
                       and composes with it rather than replacing it. *@
                    <button class="switch @(Vm.ShowChangedOnly ? "on" : "")"
                            @onclick="() => Vm.ShowChangedOnly = !Vm.ShowChangedOnly"
                            title="Narrow the tree to what has been changed. Ancestors come along, so it stays a tree you can navigate.">
                        <span class="switch-track"><span class="switch-knob"></span></span>
                        <span>Changed</span>
                    </button>

                    <SearchBox Value="@Vm.Filter" ValueChanged="v => Vm.Filter = v"
                               Placeholder="Path substring, or a glob with *" Dense="true" />
                </div>

                <div class="tree-actions">
                    <button class="btn btn-small" @onclick="() => Vm.ExpandAllCommand.Execute(null)">Expand all</button>
                    <button class="btn btn-small" @onclick="() => Vm.CollapseAllCommand.Execute(null)">Collapse all</button>
                    <span class="caption inline">@Vm.Nodes.Count rows</span>
                </div>

                <div class="tree-list">
                    @foreach (var node in Vm.Nodes)
                    {
                        <div class="tree-row @(ReferenceEquals(node, Vm.SelectedNode) ? "selected" : "") @(node.IsRemoved ? "removed" : "")"
                             @key="node.Path"
                             style="padding-left:@(6 + node.Depth * 14)px"
                             @onclick="() => Vm.SelectedNode = node">

                            @if (node.IsContainer)
                            {
                                <button class="twisty" @onclick:stopPropagation="true"
                                        @onclick="() => Vm.ToggleNodeCommand.Execute(node)">
                                    <Icon Name="@(node.IsExpanded ? "chevron-down" : "chevron-right")" Size="12" />
                                </button>
                            }
                            else
                            {
                                <span class="twisty-spacer"></span>
                            }

                            @* The mark says WHICH KIND of change it is, because "changed" is three
                               different things and a tree that renders them identically makes you open
                               every marked node to find out which. A parent that merely holds changes
                               is the fourth, and is deliberately not labelled as an edit. *@
                            @if (node.Change != NodeChange.None)
                            {
                                <span class="mark mark-@node.Change.ToString().ToLowerInvariant()"
                                      title="@node.ChangedTooltip">
                                    @if (node.Change == NodeChange.Edited)
                                    {
                                        @* Drawn rather than typed. The pencil has no ASCII form, and
                                           U+270F renders as a full-colour emoji on most platforms —
                                           a cartoon beside three flat findings-coloured glyphs. The
                                           WPF tree borrows its icon font for exactly this one mark. *@
                                        <Icon Name="edit" Size="11" />
                                    }
                                    else
                                    {
                                        @MarkGlyph(node.Change)
                                    }
                                </span>
                            }
                            else
                            {
                                <span class="mark-spacer"></span>
                            }

                            <span class="tree-name">@node.Name</span>

                            @if (node.IsContainer)
                            {
                                <span class="tree-summary">@node.Summary</span>
                            }
                            else
                            {
                                <span class="tree-preview @(node.ContainsSecret ? "is-secret" : "")">@node.Preview</span>
                            }

                            @* Copies the row as it would sit inside its parent — "key": value — where
                               the pane's Copy takes the value alone. On the row rather than the strip
                               because it works on any row, selected or not. *@
                            <button class="row-copy" title='Copy this node together with its key — "@node.Name": …'
                                    @onclick:stopPropagation="true"
                                    @onclick="() => Vm.CopyNodeWithKeyCommand.Execute(node)">
                                <Icon Name="copy" Size="11" />
                            </button>
                        </div>
                    }

                    @if (Vm.Nodes.Count == 0)
                    {
                        @* When it finds nothing it says which of the two reasons applies. *@
                        <div class="grid-empty">
                            @(Vm.ShowChangedOnly && !Vm.IsModified
                                ? "Nothing has been changed yet."
                                : "Nothing matches.")
                        </div>
                    }
                </div>
            </div>

            @* -------------------------------- Pane -------------------------------- *@
            <div class="card card-flush editor-pane">
                <div class="pane-head">
                    <span class="section-label" title="Replace this node wholesale. Any valid JSON is accepted, including a different shape.">
                        @Vm.PaneHeader
                    </span>

                    <div class="pane-head-actions">
                        <button class="switch small @(Vm.CompactJson ? "on" : "")"
                                @onclick="() => Vm.CompactJson = !Vm.CompactJson"
                                title="Display only — nothing compact is ever written. Switching mid-edit reformats what is in the pane rather than reloading the node, so an edit in progress survives it.">
                            <span class="switch-track"><span class="switch-knob"></span></span>
                            <span>Compact</span>
                        </button>
                        <button class="switch small @(Vm.WordWrap ? "on" : "")"
                                @onclick="() => Vm.WordWrap = !Vm.WordWrap"
                                title="On by default: some of these values are tokens and PEM blocks hundreds of characters long, and reading one a screen-width at a time is not reading it.">
                            <span class="switch-track"><span class="switch-knob"></span></span>
                            <span>Wrap</span>
                        </button>
                    </div>
                </div>

                @if (Vm.ShowingComparison)
                {
                    @* Laid out as opened | as edited, so a removed line has somewhere to appear and a
                       changed one shows what it changed from. Its three colours are the tree's —
                       green added, red removed, amber edited — rather than the blue that elsewhere in
                       this app means "these two tiers differ". *@
                    <DiffLinesView Lines="Vm.ComparisonLines" EmptyMessage="No difference here." />
                }
                else
                {
                    @if (Vm.FindOpen)
                    {
                        @* One row with replace beside it rather than under it: it is open most of the
                           time it is in use, and a second row pushes the text down by a whole field. *@
                        <div class="findbar">
                            <input class="field dense" type="text" placeholder="Find" @ref="_findInput"
                                   value="@Vm.FindText"
                                   @oninput="e => Vm.FindText = e.Value?.ToString() ?? string.Empty"
                                   @onkeydown="OnFindKey" />

                            <button class="btn btn-small @(Vm.MatchCase ? "toggled" : "")"
                                    @onclick="() => Vm.MatchCase = !Vm.MatchCase"
                                    title="Match case. Worth having: this file's ordinal key order treats Url and URL as two keys.">Aa</button>

                            @* A fixed-width slot, so a count changing as you type does not shove the
                               row sideways. *@
                            <span class="find-count">@Vm.FindStatus</span>

                            <button class="btn btn-small" disabled="@(!Vm.HasMatches)"
                                    @onclick="() => Step(forward: false)" title="Previous (Shift+Enter, Shift+F3)">↑</button>
                            <button class="btn btn-small" disabled="@(!Vm.HasMatches)"
                                    @onclick="() => Step(forward: true)" title="Next (Enter, F3)">↓</button>

                            <input class="field dense" type="text" placeholder="Replace with"
                                   disabled="@Vm.IsEditorReadOnly"
                                   value="@Vm.ReplaceText"
                                   @oninput="e => Vm.ReplaceText = e.Value?.ToString() ?? string.Empty"
                                   @onkeydown="OnFindKey" />

                            <button class="btn btn-small" disabled="@(!Vm.CanReplace)"
                                    @onclick="ReplaceOne"
                                    title="Replace the current match and move to the next one.">Replace</button>
                            <button class="btn btn-small" disabled="@(!Vm.CanReplace)"
                                    @onclick="ReplaceAll"
                                    title="Replace every match in this pane. Still only in the pane — a section needs Update node afterwards.">Replace all</button>

                            <button class="btn-ghost-tiny" @onclick="() => Vm.CloseFindCommand.Execute(null)" title="Close (Esc)">
                                <Icon Name="close" Size="12" />
                            </button>
                        </div>
                    }

                    @* ⚠ This pane renders values in clear, credentials included. It is the one screen
                       in the app that does, and it has to be: a subtree cannot be retyped without
                       being read. The hierarchy beside it still shows secrets masked.

                       The highlight layer sits BEHIND a transparent textarea holding the same string
                       in the same font at the same metrics, so its <mark> backgrounds land exactly
                       under the runs they mark. A textarea cannot colour part of its own content and
                       an unfocused one paints no selection at all — which is why stepping through
                       matches had to either steal the caret from the find box or show nothing. *@
                    <div class="pane-stack">
                        @if (Vm.HasMatches)
                        {
                            <div class="pane-highlights @(Vm.WordWrap ? "wrap" : "nowrap") @(Vm.IsEditorReadOnly ? "readonly" : "")"
                                 @ref="_highlightLayer"
                                 aria-hidden="true">@foreach (var run in HighlightRuns()) {<span class="@run.Class">@run.Text</span>}</div>
                        }

                        <textarea class="pane-text @(Vm.WordWrap ? "wrap" : "nowrap") @(Vm.HasMatches ? "over-highlights" : "")"
                                  @ref="_paneInput"
                                  readonly="@Vm.IsEditorReadOnly"
                                  spellcheck="false"
                                  value="@Vm.EditorText"
                                  @onclick="SyncToCaret"
                                  @onkeyup="OnPaneKeyUp"
                                  @oninput="e => Vm.EditorText = e.Value?.ToString() ?? string.Empty"></textarea>
                    </div>

                    <div class="pane-strip">
                        @* The reason Update is off, where the text it is about is — not in the banner
                           at the top of the tab, which is for things that went wrong. Half-typed JSON
                           has not gone wrong; it is on its way in. *@
                        <span class="commit-hint @(Vm.HasEditorProblem ? "is-problem" : "")">
                            @(Vm.HasEditorProblem ? Vm.EditorProblem : Vm.CommitHint)
                        </span>

                        <div class="pane-actions">
                            @* Primary, matching the WPF pane: this is the one button in the row that
                               commits, and the four beside it all discard or copy. Rendered the same
                               as its plain neighbours, the commit action was the hardest to find. *@
                            <button class="btn btn-small btn-primary" disabled="@(!Vm.CanApply)"
                                    @onclick="() => Vm.ApplyCommand.Execute(null)"
                                    title="@(Vm.HasEditorProblem
                                               ? "The pane does not parse, so there is nothing to apply. The reason is beside this button."
                                               : "Apply the pane to this node. Any valid JSON is accepted, including a different shape. Off while the pane matches the document, and while it does not parse.")">
                                Update node
                            </button>
                            <button class="btn btn-small" @onclick="() => Vm.ReloadNodeCommand.Execute(null)"
                                    title="Forget what is typed here and show the node as the document currently has it. Changes nothing.">
                                Reload node
                            </button>
                            <button class="btn btn-small" disabled="@(!Vm.CanRevertNode)"
                                    @onclick="() => Vm.RevertNodeCommand.Execute(null)"
                                    title="Forget the changes already applied to this node, leaving every other edit alone.">
                                @Vm.RevertNodeLabel
                            </button>
                            <button class="btn btn-small" @onclick="() => Vm.CopyNodeCommand.Execute(null)"
                                    title="Copy exactly what is on screen, edits included.">
                                <Icon Name="copy" Size="13" /> <span>Copy</span>
                            </button>
                            <button class="btn btn-small" disabled="@(!Vm.CanRemoveNode)"
                                    @onclick="() => Vm.RemoveNodeCommand.Execute(null)"
                                    title="Delete this node. It stays in the tree as a tombstone until the tier is saved, so it can be put back.">
                                <Icon Name="trash" Size="13" /> <span>Remove node</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private ElementReference _findInput;
    private ElementReference _paneInput;
    private ElementReference _highlightLayer;
    private bool _findWasOpen;
    private bool _tracking;

    protected override void ObserveAlso(JsonEditorVm? vm)
    {
        Observe(vm?.Nodes, vm?.Tiers, vm?.ComparisonLines);
        ObserveNodes();
    }

    protected override async Task OnAfterRenderAsync(bool first)
    {
        ObserveNodes();

        // The find bar is focused the moment it appears; opening one you then have to click into is
        // a shortcut that saved nothing.
        if (Vm is { FindOpen: true } && !_findWasOpen)
        {
            await Js.InvokeVoidAsync("jsonInsight.focus", _findInput);
        }

        _findWasOpen = Vm?.FindOpen ?? false;

        // The layer only exists while there is something to highlight, so the scroll handler is
        // re-attached whenever it comes back — and dropped from tracking when it goes, so a stale
        // element reference is never written to.
        var showing = Vm is { HasMatches: true };

        if (showing)
        {
            await Js.InvokeVoidAsync("jsonInsight.trackScroll", _paneInput, _highlightLayer);
        }
        else if (_tracking)
        {
            await Js.InvokeVoidAsync("jsonInsight.trackScroll", _paneInput, null);
        }

        _tracking = showing;
    }

    /// <summary>
    /// Each row individually: Change and Preview live on the node, and a scalar applied as you type
    /// re-marks its own row in place rather than rebuilding the tree — which is exactly the update a
    /// component watching only the collection would miss.
    /// </summary>
    private void ObserveNodes()
    {
        if (Vm is null)
        {
            return;
        }

        foreach (var node in Vm.Nodes)
        {
            Observe(node);
        }
    }

    /// <summary>
    /// Hands the document as edited in the pane to the push screen. The edited tree, not the tier's
    /// own — the whole point of this tab is the difference between the two.
    /// </summary>
    private void OpenPush()
    {
        if (Vm?.Tier is { } tier)
        {
            Dialogs.OpenPush(tier, Vm.Editor?.Working, "the document as edited on the Tier editor tab");
        }
    }

    /// <summary>
    /// The three marks that are legible as characters. Edited is not one of them — it is drawn as an
    /// icon at the call site, for the reason given there.
    /// </summary>
    private static string MarkGlyph(NodeChange change) => change switch
    {
        NodeChange.Added => "+",
        NodeChange.Removed => "−",
        NodeChange.Mixed => "*",
        _ => string.Empty,
    };

    // ------------------------------------------------------------------ find

    /// <summary>
    /// Enter steps forward, Shift+Enter back, Escape closes — the three answers the field can have.
    /// F3 too, so the same key works whether the caret is in the box or in the pane.
    /// </summary>
    private async Task OnFindKey(KeyboardEventArgs e)
    {
        switch (JsonEditorVm.FindBoxKey(e.Key, e.ShiftKey))
        {
            case JsonEditorVm.FindKey.Next:
                await Step(forward: true);
                break;

            case JsonEditorVm.FindKey.Previous:
                await Step(forward: false);
                break;

            case JsonEditorVm.FindKey.Close:
                Vm?.CloseFindCommand.Execute(null);
                break;
        }
    }

    /// <summary>
    /// F3 works from inside the pane as well, which is where it is pressed from. Ctrl+F is not handled
    /// here even though the shared map knows it: on this host it arrives through the global shortcut
    /// registered in interop.js, and answering it twice would toggle the bar back shut.
    /// </summary>
    private async Task OnPaneKeyUp(KeyboardEventArgs e)
    {
        if (Vm is not { FindOpen: true })
        {
            return;
        }

        switch (JsonEditorVm.PaneKey(e.Key, e.ShiftKey, control: false))
        {
            case JsonEditorVm.FindKey.Next:
                await Step(forward: true);
                break;

            case JsonEditorVm.FindKey.Previous:
                await Step(forward: false);
                break;
        }
    }

    /// <summary>
    /// A click in the pane moves the search's idea of "here", so the next Enter continues from where
    /// you are looking rather than from wherever the last step stopped.
    /// </summary>
    private async Task SyncToCaret()
    {
        if (Vm is { FindOpen: true, HasMatches: true })
        {
            Vm.SyncMatchToCaret(await CaretAsync());
        }
    }

    /// <summary>
    /// The next or previous match, revealed in the pane. Which match that is comes from
    /// <see cref="JsonEditorVm.StepMatch"/> — an index into the match list, shared with the WPF view.
    ///
    /// <para>
    /// It used to search from the caret, which sits <em>at</em> the current match after a step, so ↓
    /// found the same one again. And it focused the pane to show the selection, which took the caret
    /// out of the find box and turned the second Enter into a newline in the JSON. Neither is
    /// possible now: the index advances by construction, and the highlight layer shows the match
    /// without the pane needing focus.
    /// </para>
    /// </summary>
    private async Task Step(bool forward)
    {
        if (Vm is null)
        {
            return;
        }

        var hit = Vm.StepMatch(forward);
        if (hit < 0)
        {
            return;
        }

        await Js.InvokeVoidAsync("jsonInsight.reveal", _paneInput, hit, Vm.FindText.Length);
    }

    /// <summary>
    /// Replace and Replace all edit the PANE, not the document — for a section, Update node still has
    /// to follow, which is what keeps a bulk replace reviewable before it lands.
    /// </summary>
    private async Task ReplaceOne()
    {
        if (Vm is null || Vm.ReplaceCurrent() < 0)
        {
            return;
        }

        if (Vm.MatchAt >= 0)
        {
            await Js.InvokeVoidAsync("jsonInsight.reveal", _paneInput, Vm.MatchAt, Vm.FindText.Length);
        }
    }

    private void ReplaceAll() => Vm?.ReplaceAllInPane();

    private async Task<int> CaretAsync() => await Js.InvokeAsync<int>("jsonInsight.caret", _paneInput);

    // -------------------------------------------------------------- highlighting

    /// <summary>One run of pane text: plain, or one of the matches.</summary>
    private readonly record struct Run(string Text, string Class);

    /// <summary>
    /// The pane's text cut into runs — the gaps between matches, and the matches themselves — for the
    /// layer that sits behind the textarea.
    ///
    /// <para>
    /// The whole string is emitted, not just the matches: the layer only lines up with the text in
    /// front of it if it holds the same characters, in the same font, wrapped the same way. The
    /// current match gets its own class so it reads as the one Enter is on rather than as one of
    /// twelve identical blocks.
    /// </para>
    /// </summary>
    private IEnumerable<Run> HighlightRuns()
    {
        if (Vm is null)
        {
            yield break;
        }

        var text = Vm.EditorText;
        var length = Vm.FindText.Length;
        var at = 0;

        for (var i = 0; i < Vm.Matches.Count; i++)
        {
            var start = Vm.Matches[i];
            if (start < at || start + length > text.Length)
            {
                // The text moved under a stale list; the next render has the right one.
                break;
            }

            if (start > at)
            {
                yield return new Run(text[at..start], "hl-gap");
            }

            yield return new Run(text.Substring(start, length), i == Vm.MatchIndex ? "hl hl-current" : "hl");
            at = start + length;
        }

        // The trailing newline keeps the layer's scroll height equal to the textarea's: a textarea
        // reserves a line for a final newline and a div does not, so without it the two drift apart
        // by one line at the very bottom of a long document.
        yield return new Run(text[at..] + "\n", "hl-gap");
    }
}
