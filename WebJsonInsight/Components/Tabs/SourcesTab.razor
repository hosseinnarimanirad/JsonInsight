@*
    Sources — one row per environment, saying where that environment's JSON comes from and whether it
    is one of the columns the other tabs compare.

    One list, and nothing above it. A row is either a Vault secret — the whole path to one JSON, with
    its own address, token and TLS setting — or a local file. Everything about a row is on that one
    line, which is the arrangement that replaced a shared-credentials card plus a rule about which won.
*@
@inherits ObservingComponent<VaultVm>
@inject DialogService Dialogs

@if (Vm is null)
{
    <div class="empty">Sources are not available.</div>
}
else
{
    <div class="sources">

        @if (Vm.Problems.Count > 0)
        {
            <div class="notice notice-danger">
                <Icon Name="warn" />
                <div>
                    @foreach (var problem in Vm.Problems)
                    {
                        <div>@problem</div>
                    }
                </div>
            </div>
        }

        @* Takes whatever height the tab has left, so the notes underneath sit at the bottom of the
           page rather than immediately under six rows with a screen of nothing below them. *@
        <section class="card card-flush src-list">
            <div class="card-head">
                <span class="section-label">SOURCES</span>
                <div class="head-right">
                    <span class="caption inline">@Vm.ActiveSummary</span>
                    <button class="btn" @onclick="() => Vm.ReloadSettingsCommand.Execute(null)"
                            title="Throw away unsaved edits on this tab and read the settings files again.">
                        <Icon Name="refresh" /> <span>Revert</span>
                    </button>
                    <button class="btn btn-primary" disabled="@(!Vm.CanSaveSettings)"
                            @onclick="() => Vm.SaveSettingsCommand.Execute(null)"
                            title="@(Vm.CanSaveSettings
                                       ? "Write the paths and addresses to appsettings.json and the tokens to user secrets, then rebuild the other tabs around what is now ticked. Only a source that is new or has been repointed is read again."
                                       : Vm.DuplicateError)">
                        <span>Save settings</span>
                    </button>
                </div>
            </div>

            @* Left to right in the order a row gets filled in: what it is, where its server is, as
               whom, then what to ask for — and only then the two buttons that act on the answer. *@
            <div class="src-head">
                <div class="src-c-on" title="Whether this source is one of the columns the other tabs compare. Four at a time.">ON</div>
                <div class="src-c-env">ENVIRONMENT</div>
                <div class="src-c-kind">KIND</div>
                <div class="src-c-addr">ADDRESS</div>
                <div class="src-c-tok">TOKEN</div>
                <div class="src-c-path">JSON PATH</div>
                <div class="src-c-act"></div>
            </div>

            @foreach (var row in Vm.Connections)
            {
                <div class="src-row @(row.Active ? "is-active" : "")" @key="row.TierId">

                    <div class="src-c-on">
                        <input type="checkbox" checked="@row.Active" disabled="@(!row.CanActivate)"
                               title="@(row.CanActivate
                                          ? "Compare this source. Four at a time; a fifth is refused with a reason."
                                          : $"'{row.TierId}' is not one of the predefined environments, so it cannot be compared.")"
                               @onchange="e => row.Active = (bool?)e.Value ?? false" />
                    </div>

                    <div class="src-c-env">
                        <span class="src-env">@row.Label</span>
                        @if (!row.CanActivate)
                        {
                            <span class="pill pill-warn" title="Not one of the predefined environment names, so it cannot join the comparison. Shown rather than dropped, so it can be seen and fixed.">unknown</span>
                        }
                    </div>

                    <div class="src-c-kind">
                        <select class="field dense" value="@row.Kind"
                                @onchange="e => OnKindChanged(row, e)">
                            @foreach (var kind in Vm.Kinds)
                            {
                                <option value="@kind.Kind" selected="@(kind.Kind == row.Kind)">@kind.Label</option>
                            }
                        </select>
                    </div>

                    @if (row.IsVault)
                    {
                        <div class="src-c-addr">
                            @* onfocus is a plain DOM attribute, not a Blazor handler: selecting all
                               on focus needs no round trip, and the usual edit here is replacing
                               one server with another rather than appending to it. *@
                            <input class="field dense" type="text" placeholder="https://vault.example.com:8200"
                                   title="This row's own Vault server. Rows do not share one — beta and prod are not on the same host as stage."
                                   value="@row.Address"
                                   onfocus="this.select()"
                                   @oninput="e => row.Address = e.Value?.ToString() ?? string.Empty" />

                            @* On the row, not only in the menu. Certificate checking being off is a
                               property of this connection worth seeing without opening anything —
                               a setting you cannot see is one you forget you turned on. *@
                            @if (row.AllowInsecureTls)
                            {
                                <span class="pill pill-warn"
                                      title="Certificate checking is off for this row. Set in the ⋮ menu.">TLS off</span>
                            }
                        </div>

                        <div class="src-c-tok">
                            @* type=password so a token is not left on screen. It goes only to user
                               secrets — VaultConnection.Token is [JsonIgnore], so the serializer that
                               writes appsettings.json cannot emit it. *@
                            <input class="field dense" type="password" placeholder="@(row.HasToken ? "••••••••" : "hvs.…")"
                                   title="Stored in .NET user secrets, never in appsettings.json."
                                   value="@row.Token"
                                   @oninput="e => row.Token = e.Value?.ToString() ?? string.Empty" />
                        </div>

                        @* Search and the field it fills, in that order — see PathPicker. *@
                        <div class="src-c-path">
                            <PathPicker Row="row" Vm="Vm" />
                        </div>
                    }
                    else
                    {
                        @* A local file has no server and no token, and empty boxes claiming otherwise
                           would be four fields that can never be filled in. *@
                        <div class="src-c-addr src-na">—</div>
                        <div class="src-c-tok src-na">—</div>

                        <div class="src-c-path">
                            @* Browse before the box, where a Vault row has Search: the same column,
                               the same job, so the same place. *@
                            <button class="btn btn-small" @onclick="() => Vm.BrowseLocalFileCommand.Execute(row)"
                                    title="Pick the file this source reads.">
                                <Icon Name="folder" Size="13" /> <span>Browse</span>
                            </button>
                            <input class="field dense mono" type="text" placeholder="D:\snapshots\dev.json"
                                   title="One JSON file on disk. Read live on every load and written in place — it is the environment, not a copy of one."
                                   value="@row.LocalFilePath"
                                   @oninput="e => row.LocalFilePath = e.Value?.ToString() ?? string.Empty" />
                        </div>
                    }

                    <div class="src-c-act">
                        @* Test then Load, in that order and in that dependency: Test is the only
                           thing that turns Load on. It came out of the ⋮ menu to sit here because a
                           button you must press before the next one works is not an occasional
                           option. *@
                        <button class="btn btn-small" disabled="@(!row.CanTest)"
                                @onclick="() => Test(row)"
                                title="@TestHint(row)">
                            <Icon Name="ok" Size="13" /> <span>Test</span>
                        </button>

                        @* Pull reads all four sources; this reads the one whose path you just fixed,
                           and afterwards the other tabs are showing it - which is what you wanted
                           Pull for. *@
                        <button class="btn btn-small btn-primary" disabled="@(!row.CanLoad)"
                                @onclick="() => Vm.LoadRowCommand.ExecuteAsync(row)"
                                title="@LoadHint(row)">
                            @if (row.Busy)
                            {
                                <Icon Name="refresh" Size="13" Class="spinning" />
                            }
                            <span>@(row.Busy ? "Loading…" : "Load")</span>
                        </button>

                        @* What is left is Vault-only and occasional: a TLS exception set once, an
                           endpoint configured once, and a restart that should never be one click
                           from a list of environments that all look alike. A local-file row has no
                           certificate to trust and nothing running behind it to restart, so it gets
                           no menu at all rather than an empty one.

                           Call restart stays a separate item from Restart config for the reason the
                           two buttons were always separate: one is a configuration act, the other is
                           destructive, and a single item that sometimes opens a form and sometimes
                           restarts production would be the wrong one to press by habit. *@
                        @if (row.IsVault)
                        {
                            <div class="rowmenu">
                                <button class="btn btn-small btn-icon @(row.MenuOpen ? "is-open" : "")"
                                        @onclick="() => Vm.ToggleMenuCommand.Execute(row)"
                                        aria-haspopup="menu" aria-expanded="@row.MenuOpen"
                                        title="More options for this source.">
                                    <Icon Name="more" Size="14" />
                                </button>

                                @if (row.MenuOpen)
                                {
                                    @* Catches the next click anywhere else so the menu dismisses the
                                       way every other menu does, without a document-level handler. *@
                                    <div class="rowmenu-scrim" @onclick="() => Vm.CloseMenusCommand.Execute(null)"></div>

                                    <div class="rowmenu-pop" role="menu">
                                        @* A toggle, not a checkbox in a menu. It says which state it
                                           is in twice - a tick and the word - because the previous
                                           version said it once, in a bare checkbox, and reading it
                                           meant knowing that ticked meant "checking is off". *@
                                        <button class="rowmenu-item rowmenu-toggle @(row.AllowInsecureTls ? "is-on" : "")"
                                                role="menuitemcheckbox" aria-checked="@row.AllowInsecureTls"
                                                @onclick="() => row.AllowInsecureTls = !row.AllowInsecureTls"
                                                title="Accept any certificate from this row's Vault. Only for an internal server behind a self-signed cert.">
                                            <span class="rowmenu-tick">
                                                @if (row.AllowInsecureTls)
                                                {
                                                    <Icon Name="ok" Size="13" />
                                                }
                                            </span>
                                            <span>Insecure TLS</span>
                                            <span class="rowmenu-state">@(row.AllowInsecureTls ? "ON" : "OFF")</span>
                                        </button>

                                        <div class="rowmenu-sep"></div>

                                        <button class="rowmenu-item" role="menuitem"
                                                @onclick="() => OpenRestartConfig(row)"
                                                title="Set the endpoint that restarts whatever reads this source. Saved with the row; the bearer token is not.">
                                            <Icon Name="edit" Size="13" /> <span>Restart config…</span>
                                        </button>

                                        <button class="rowmenu-item @(row.HasRestart ? "is-danger" : "")"
                                                role="menuitem" disabled="@(!row.HasRestart)"
                                                @onclick="() => OpenRestart(row)"
                                                title="@row.RestartSummary">
                                            <Icon Name="refresh" Size="13" /> <span>Call restart…</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            @* The ⋮'s room, kept: without it Test and Load on a local-file row sit
                               30px right of the same two buttons on the row above. *@
                            <div class="rowmenu-gap"></div>
                        }
                    </div>

                    @* Red for a test or load that failed, neutral for everything else — only the
                       colour says which kind of news it is. *@
                    @if (!string.IsNullOrEmpty(row.Status))
                    {
                        <div class="src-row-status @(row.StatusIsError ? "is-error" : "")">@row.Status</div>
                    }
                </div>
            }
        </section>

        @* The duplicate-source complaint. Red, its own notice rather than a Status write: it is
           what disables Save settings, and it stays for as long as the clash exists instead of
           scrolling away under the next report. *@
        @if (!string.IsNullOrEmpty(Vm.DuplicateError))
        {
            <div class="notice notice-danger">
                <Icon Name="warn" />
                <div>@Vm.DuplicateError</div>
            </div>
        }

        @if (!string.IsNullOrEmpty(Vm.Status))
        {
            <div class="notice notice-info">@Vm.Status</div>
        }

        <p class="caption">
            Paths, addresses and the active set persist to <code>appsettings.json</code> under the open
            project. Tokens go only to .NET user secrets — <code>@Vm.SecretsFile</code> — enforced
            structurally: the token properties are <code>[JsonIgnore]</code>, so the serializer that
            produces appsettings.json cannot emit them.
        </p>
    </div>
}

@code {
    protected override void ObserveAlso(VaultVm? vm)
    {
        Observe(vm?.Connections, vm?.Problems);
        ObserveRows();
    }

    protected override void OnAfterRender(bool first) => ObserveRows();

    private void ObserveRows()
    {
        if (Vm is null)
        {
            return;
        }

        foreach (var row in Vm.Connections)
        {
            // The row and its found-paths list: a Search replaces KnownPaths, and the datalist has to
            // be re-rendered for the new entries to be offered.
            Observe(row, row.KnownPaths);
        }
    }

    /// <summary>
    /// Closes the menu before opening a dialog. Without this it is still open behind the modal and
    /// still there when the dialog is dismissed, which reads as a menu that failed to respond.
    /// </summary>
    private void OpenRestartConfig(VaultConnectionVm row)
    {
        Vm?.CloseMenusCommand.Execute(null);
        Dialogs.OpenRestartConfig(row);
    }

    private void OpenRestart(VaultConnectionVm row)
    {
        Vm?.CloseMenusCommand.Execute(null);
        Dialogs.OpenRestart(row);
    }

    /// <summary>
    /// Test closes any open menu first: its answer lands in the row's status line underneath, which
    /// an open menu would be covering.
    /// </summary>
    private Task Test(VaultConnectionVm row)
    {
        Vm?.CloseMenusCommand.Execute(null);
        return Vm?.TestCommand.ExecuteAsync(row) ?? Task.CompletedTask;
    }

    /// <summary>
    /// Why Test is greyed out, or what it does when it is not. A disabled button that does not say
    /// what is missing is one people press repeatedly and then report as broken.
    /// </summary>
    private static string TestHint(VaultConnectionVm row) => row switch
    {
        { Busy: true } => "Reading this source now.",

        { CanTest: true } =>
            "Test connection — read what this row points at and report what is there: version and " +
            "key count for a Vault secret, key count and file details for a file. Keeps nothing and " +
            "changes nothing on the other tabs. Load turns on once this succeeds.",

        { IsLocalFile: true } =>
            "Name the file first — press Browse, or type a path. There is nothing to read yet.",

        _ => "Fill in the address, the token and the JSON path first. There is nothing to read yet.",
    };

    /// <summary>The same for Load, whose one precondition is a Test that passed.</summary>
    private static string LoadHint(VaultConnectionVm row) => row switch
    {
        { Busy: true } => "Reading this source now.",

        { CanLoad: true } =>
            "Read this source now and show it on the Tier editor, All tiers and Text diff. Pull in " +
            "the title bar does all of them; this does one.",

        _ =>
            "Press Test first. Load puts what it reads on every other tab, so it waits for something " +
            "that says this row points where you think it does — and waits again after any edit to it.",
    };

    /// <summary>
    /// The select hands back the enum's name; the row wants the enum. Parsed rather than bound
    /// directly because switching kind changes which half of the row is even shown.
    /// </summary>
    private static void OnKindChanged(VaultConnectionVm row, ChangeEventArgs e) =>
        Choice.Set<SourceKind>(e, kind => row.Kind = kind);
}
