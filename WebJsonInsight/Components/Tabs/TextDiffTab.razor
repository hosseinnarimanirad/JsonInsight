@*
    Text diff — any two configured sources, both serialized through the same writer and diffed line by
    line, laid out as left | as right.

    Both sides go through OrdinalJsonWriter, so what shows up is content rather than formatting. Long
    lines wrap rather than scrolling sideways: a PEM block or a 900-character token used to carry the
    right-hand column off the screen with it, so a two-column diff read as a one-column one until you
    scrolled to find the other side.
*@
@inherits ObservingComponent<RawDiffVm>

@if (Vm is null)
{
    <div class="empty">No project is open.</div>
}
else
{
    <div class="rawdiff">

        <div class="card rawdiff-toolbar">
            <div class="toolbar-row">
                <label for="diff-left">Left</label>
                <select id="diff-left" class="field" value="@Vm.Left?.Id"
                        @onchange="e => Vm.Left = Find(e.Value?.ToString())">
                    @foreach (var document in Vm.Documents)
                    {
                        <option value="@document.Id" selected="@(document.Id == Vm.Left?.Id)">@document.Label</option>
                    }
                </select>

                <button class="btn btn-icon" @onclick="() => Vm.SwapCommand.Execute(null)" title="Swap the two sides">
                    <Icon Name="refresh" />
                </button>

                <label for="diff-right">Right</label>
                <select id="diff-right" class="field" value="@Vm.Right?.Id"
                        @onchange="e => Vm.Right = Find(e.Value?.ToString())">
                    @foreach (var document in Vm.Documents)
                    {
                        <option value="@document.Id" selected="@(document.Id == Vm.Right?.Id)">@document.Label</option>
                    }
                </select>

                <label class="check">
                    <input type="checkbox" checked="@Vm.HideUnchanged"
                           @onchange="e => Vm.HideUnchanged = (bool?)e.Value ?? false" />
                    <span>Hide unchanged</span>
                </label>

                <span class="caption inline">@Vm.Summary</span>
            </div>

            @if (Vm.Documents.Count < 2)
            {
                <p class="caption">
                    This tab needs two sources that loaded. Pull from Vault or disk, or tick more on the
                    Sources tab.
                </p>
            }
        </div>

        <div class="card card-flush difflines-card">
            <DiffLinesView Lines="Vm.Lines" LeftHeader="@LeftHeader" RightHeader="@RightHeader"
                           EmptyMessage="@EmptyMessage" />
        </div>
    </div>
}

@code {
    protected override void ObserveAlso(RawDiffVm? vm) => Observe(vm?.Lines);

    private TierDocument? Find(string? id) =>
        Vm?.Documents.FirstOrDefault(d => d.Id.Equals(id, StringComparison.OrdinalIgnoreCase));

    // "AS DEV" / "AS STAGE" rather than the picker's label: the columns are wide and the heading is
    // read at a glance, and the version suffix the picker carries would move under every reload.
    private string LeftHeader => "AS " + (Vm?.Left?.Id.ToUpperInvariant() ?? "LEFT");

    private string RightHeader => "AS " + (Vm?.Right?.Id.ToUpperInvariant() ?? "RIGHT");

    // Two different findings, and they must not be confused: nothing was picked, or the two that
    // were picked hold the same bytes.
    private string EmptyMessage => Vm?.Left is null || Vm?.Right is null
        ? "Pick two sources."
        : "These two are identical, line for line.";
}
