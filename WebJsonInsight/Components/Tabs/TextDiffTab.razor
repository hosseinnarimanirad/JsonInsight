@*
    Text diff — any two configured sources, both serialized through the same writer and diffed line by
    line, laid out as left | as right.

    Both sides go through OrdinalJsonWriter, so what shows up is content rather than formatting. Long
    lines wrap rather than scrolling sideways: a PEM block or a 900-character token used to carry the
    right-hand column off the screen with it, so a two-column diff read as a one-column one until you
    scrolled to find the other side.
*@
@inherits ObservingComponent<RawDiffVm>

@if (Vm is null)
{
    <div class="empty">No project is open.</div>
}
else
{
    <div class="rawdiff">

        <div class="card rawdiff-toolbar">
            <div class="toolbar-row">
                @Side(Vm.LeftSide, "left", "Left")

                <button class="btn btn-icon" @onclick="() => Vm.SwapCommand.Execute(null)" title="Swap the two sides">
                    <Icon Name="refresh" />
                </button>

                @Side(Vm.RightSide, "right", "Right")

                <label class="check">
                    <input type="checkbox" checked="@Vm.HideUnchanged"
                           @onchange="e => Vm.HideUnchanged = (bool?)e.Value ?? false" />
                    <span>Hide unchanged</span>
                </label>
            </div>

            <div class="toolbar-row">
                <span class="caption inline">@Vm.Summary</span>
                @if (Vm.CopyNote is { } note)
                {
                    <span class="caption inline">@note</span>
                }
            </div>

            @foreach (var (side, label) in new[] { (Vm.LeftSide, "Left"), (Vm.RightSide, "Right") })
            {
                if (side.Status is { } status)
                {
                    <p class="caption">@label: @status</p>
                }
            }

            @if (Vm.Documents.Count < 2)
            {
                <p class="caption">
                    This tab needs two sources that loaded. Pull from Vault or disk, or tick more on the
                    Sources tab.
                </p>
            }
        </div>

        <div class="card card-flush difflines-card">
            <DiffLinesView Lines="Vm.Lines" LeftHeader="@LeftHeader" RightHeader="@RightHeader"
                           EmptyMessage="@EmptyMessage" />
        </div>
    </div>
}

@code {
    // Both sides, and their version lists: a version read finishes after the click that started it,
    // and Swap exchanges the two side objects rather than their contents, so both are watched.
    protected override void ObserveAlso(RawDiffVm? vm) =>
        Observe(vm?.Lines, vm?.LeftSide, vm?.RightSide, vm?.LeftSide.Versions, vm?.RightSide.Versions);

    /// <summary>
    /// One side's pickers: the source, and which version of it. The version picker's last entry,
    /// "Earlier versions…", is what reads the list from Vault — nothing is asked until it is picked.
    /// </summary>
    private RenderFragment Side(DiffSideVm side, string id, string label) => __builder =>
    {
        <label for="diff-@id">@label</label>
        <select id="diff-@id" class="field" value="@side.Source?.Id"
                @onchange="e => SetSource(id, Find(e.Value?.ToString()))">
            @foreach (var document in Vm!.Documents)
            {
                <option value="@document.Id" selected="@(document.Id == side.Source?.Id)">@document.Label</option>
            }
        </select>

        <select id="diff-@id-version" class="field" aria-label="@label version" disabled="@side.IsBusy"
                value="@side.Versions.IndexOf(side.Selected!)"
                @onchange="e => PickVersion(side, e.Value?.ToString())">
            @for (var i = 0; i < side.Versions.Count; i++)
            {
                var choice = side.Versions[i];
                <option value="@i" disabled="@(!choice.IsEnabled)"
                        selected="@(ReferenceEquals(choice, side.Selected))">@choice.Label</option>
            }
        </select>

        @if (side.IsBusy)
        {
            <span class="spinning" title="Reading from Vault"><Icon Name="refresh" /></span>
        }

        <button class="btn btn-icon" title="Copy this side's JSON" disabled="@(side.Text is null)"
                @onclick="() => Vm!.CopyCommand.Execute(id)">
            <Icon Name="copy" />
        </button>
    };

    private void SetSource(string id, TierDocument? document)
    {
        if (id == "left")
        {
            Vm!.Left = document;
        }
        else
        {
            Vm!.Right = document;
        }
    }

    private static void PickVersion(DiffSideVm side, string? value)
    {
        if (int.TryParse(value, out var index) && index >= 0 && index < side.Versions.Count)
        {
            side.Selected = side.Versions[index];
        }
    }

    private TierDocument? Find(string? id) =>
        Vm?.Documents.FirstOrDefault(d => d.Id.Equals(id, StringComparison.OrdinalIgnoreCase));

    // "AS DEV" / "AS STAGE" rather than the picker's label: the columns are wide and the heading is
    // read at a glance, and the version suffix the picker carries would move under every reload.
    // "AS DEV" / "AS STAGE V31" rather than the picker's label: the columns are wide and the heading
    // is read at a glance. An old version names itself, because that is the one thing that must not
    // be mistaken for what the source holds now.
    private string LeftHeader => Vm?.Left is null ? "AS LEFT" : Vm.LeftSide.Header;

    private string RightHeader => Vm?.Right is null ? "AS RIGHT" : Vm.RightSide.Header;

    // Two different findings, and they must not be confused: nothing was picked, or the two that
    // were picked hold the same bytes.
    private string EmptyMessage => Vm?.Left is null || Vm?.Right is null
        ? "Pick two sources."
        : Vm.LeftSide.Text is null || Vm.RightSide.Text is null
            ? "Waiting for a version to be read."
            : "These two are identical, line for line.";
}
