@*
    The push screen — the other half of Pull, and the only way anything leaves this app.

    Four places open it and all four hand over the same shape of thing: a document and the tier it
    belongs to. They differ only in which document, which is why there is one push screen rather than
    four write buttons that each grew their own idea of what a confirmation is.

    Every fence below belongs to PushVm and the provider behind it, not to this markup. What this
    component contributes is that none of them can be skipped by pressing something: Push stays
    disabled until CanPush is true, and CanPush wants a live read, a real difference, and the tier's
    name typed out.
*@
@inherits ObservingComponent

<Modal Title="Push to Vault or disk" Subtitle="@Vm.SourceLine" OnClose="OnClose">
    <ChildContent>
    
        <div class="push">
    
            @* The address is the one thing a confirmation must not leave to be assumed. *@
            <div class="push-destination">@Vm.Destination</div>
    
            <div class="toolbar-row">
                @if (!Vm.IsTierFixed)
                {
                    <label for="push-tier">Tier</label>
                    <select id="push-tier" class="field" value="@Vm.Tier?.Id" disabled="@Vm.Busy"
                            @onchange="e => Vm.Tier = Vm.Tiers.FirstOrDefault(t => t.Id == e.Value?.ToString())">
                        @foreach (var tier in Vm.Tiers)
                        {
                            <option value="@tier.Id" selected="@(tier.Id == Vm.Tier?.Id)">@tier.Label</option>
                        }
                    </select>
                }
                else
                {
                    @* A promote plan or an edited document belongs to the tier it was built against, and a
                       picker beside it would offer to push one tier's changes into another. *@
                    <span class="pill pill-quiet">@Vm.Tier?.Id</span>
                }
    
                <button class="btn btn-primary" disabled="@Vm.Busy"
                        @onclick="() => Vm.CheckVaultCommand.ExecuteAsync(null)"
                        title="Read what this would replace, right now, and diff against it. The version this read returns is what the write carries as a check-and-set.">
                    <Icon Name="@(Vm.Busy ? "refresh" : "pull")" Class="@(Vm.Busy ? "spinning" : "")" />
                    <span>@(Vm.Busy ? "Reading…" : "Check")</span>
                </button>
    
                <label class="check">
                    <input type="checkbox" checked="@Vm.ShowUnchanged"
                           @onchange="e => Vm.ShowUnchanged = (bool?)e.Value ?? false" />
                    <span>Show unchanged</span>
                </label>
    
                <span class="caption inline">@Vm.What</span>
            </div>
    
            @if (!string.IsNullOrEmpty(Vm.Problem))
            {
                <div class="notice notice-danger"><Icon Name="warn" /> <span>@Vm.Problem</span></div>
            }
    
            @if (!string.IsNullOrEmpty(Vm.Message))
            {
                <div class="notice notice-info">@Vm.Message</div>
            }
    
            @* It is the only screen that can fail AFTER doing something, so it reports each step rather
               than one verdict — the new version number, the read-back check, and anything that went
               wrong after the write landed. *@
            @foreach (var note in Vm.Notes)
            {
                <div class="push-note">@note</div>
            }
    
            <div class="card card-flush push-diff">
                <DiffLinesView Lines="Vm.Lines" LeftHeader="@Vm.LeftHeader" RightHeader="@Vm.RightHeader"
                               EmptyMessage="@EmptyMessage" />
            </div>
        </div>
    </ChildContent>

    <Footer>
        @* Off as well when the source has moved: typing the tier's name is the act of confirming, and
           there is nothing here left to confirm. *@
        <div class="push-confirm">
            <label for="push-confirm">
                Type <strong>@Vm.Tier?.Id</strong> to confirm
            </label>
            <input id="push-confirm" class="field" type="text" autocomplete="off"
                   disabled="@(!Vm.HasChecked || Vm.Completed || Vm.IsStale)"
                   value="@Vm.ConfirmText"
                   @oninput="e => Vm.ConfirmText = e.Value?.ToString() ?? string.Empty" />
        </div>

        <span class="spacer"></span>

        <button class="btn" @onclick="OnClose">@(Vm.Completed ? "Close" : "Cancel")</button>

        <button class="btn btn-danger" disabled="@(!Vm.CanPush)"
                @onclick="() => Vm.PushCommand.ExecuteAsync(null)"
                title="@(Vm.IsStale
                           ? Vm.Stale
                           : "Write it. The payload is re-parsed before it leaves, the write carries the version read a moment ago as a check-and-set, and the result is read back and compared.")">
            <Icon Name="push" Size="13" /> <span>@(Vm.TierIsFile ? "Write to disk" : "Push to Vault")</span>
        </button>
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public PushVm Vm { get; set; } = default!;

    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnInitialized() => Observe(Vm, Vm.Lines, Vm.Notes, Vm.Tiers);

    /// <summary>
    /// The push screen reads the secret live as it opens, because the comparison being confirmed has
    /// to be against the current version rather than against whatever was on screen.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool first)
    {
        if (first && Vm.ChecksOnOpen && !Vm.HasChecked && !Vm.Busy)
        {
            await Vm.CheckVaultAsync();
        }
    }

    // No rows means one of two entirely different things, and this screen is the one place where
    // saying the wrong one would be read as permission to stop: either the check has not run yet, or
    // it ran and found nothing to send.
    private string EmptyMessage => Vm.HasChecked
        ? "Nothing differs. A payload byte-identical to what is already there is refused rather than uploaded — a version that changes nothing is noise in a history whose whole value is that every entry means something."
        : "Press Check to read what this would replace and diff against it.";
}
