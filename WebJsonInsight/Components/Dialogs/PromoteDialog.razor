@*
    Promote — copy a subtree into a source that does not have it.

    The per-key defaults come from the classifier, and they are the point of reviewing this before it
    becomes a version:

      business (bank codes, terminal ids, TTLs, flags)  copy verbatim  — genuinely identical across tiers
      infra    (urls, hosts, ports)                     placeholder    — completes the shape, fails loudly at startup
      secret                                            placeholder    — credentials are not copied between tiers

    The placeholder is deliberately not "": an empty string is a valid, deliberate value in these
    documents, so blanking a key would be indistinguishable from someone forgetting to set it.
*@
@inherits ObservingComponent

<Modal Title="@Vm.Title" Subtitle="@Vm.Subtitle" OnClose="OnClose">
    <ChildContent>
    
        <div class="promote">
    
            <div class="toolbar-row">
                <label for="promote-dest">Destination</label>
                <select id="promote-dest" class="field" value="@Vm.Destination?.Id"
                        @onchange="e => Vm.Destination = Vm.Destinations.FirstOrDefault(d => d.Id == e.Value?.ToString())">
                    @foreach (var destination in Vm.Destinations)
                    {
                        <option value="@destination.Id" selected="@(destination.Id == Vm.Destination?.Id)">@destination.Label</option>
                    }
                </select>
    
                <button class="btn btn-primary" @onclick="() => Vm.PreviewCommand.Execute(null)">Preview</button>
    
                <span class="caption inline">
                    Sources marked read-only are not offered.
                </span>
            </div>
    
            @if (!string.IsNullOrEmpty(Vm.Message))
            {
                <div class="notice notice-info">@Vm.Message</div>
            }
    
            <div class="promote-body">
                <div class="card card-flush grid-card">
                    <div class="grid-scroll">
                        <table class="grid">
                            <thead>
                                <tr>
                                    <th class="col-path">KEY</th>
                                    <th style="width:62px">CLASS</th>
                                    <th style="width:150px">ACTION</th>
                                    <th class="col-tier">VALUE WRITTEN</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var leaf in Vm.Leaves)
                                {
                                    <tr @key="leaf.Path" title="@leaf.Reason">
                                        <td class="col-path"><span class="path-label">@leaf.Path</span></td>
                                        <td class="class-@leaf.ClassName">@leaf.ClassName</td>
                                        <td>
                                            <select class="field dense" value="@leaf.Action"
                                                    @onchange="e => OnAction(leaf, e)">
                                                @foreach (var action in Actions)
                                                {
                                                    <option value="@action" selected="@(action == leaf.Action)">@Label(action)</option>
                                                }
                                            </select>
                                        </td>
                                        <td class="col-tier @(leaf.ClassName == "secret" ? "cell-secret" : "")">@leaf.ResultDisplay</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
    
                <div class="card card-flush grid-card">
                    <DiffLinesView Lines="Vm.PreviewLines" LeftHeader="AS IT IS"
                                   RightHeader="WITH THIS PROMOTED IN" EmptyMessage="Press Preview." />
                </div>
            </div>
        </div>
    </ChildContent>

    <Footer>
        <span class="caption inline">
            A placeholder value fails loudly at startup rather than quietly working — which is the
            point of it. The push screen lists the keys that carry one.
        </span>
        <span class="spacer"></span>
        <button class="btn" @onclick="OnClose">Cancel</button>
        <button class="btn btn-primary" disabled="@(!Vm.CanPush)" @onclick="Apply"
                title="Adds this subtree to the destination in memory. Nothing is written — push it from the top bar or the Tier editor when you are ready.">
            <Icon Name="ok" Size="13" /> <span>@Vm.ApplyLabel</span>
        </button>
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public PromoteVm Vm { get; set; } = default!;

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Handed the destination-with-the-subtree-added, for the one push screen to confirm.</summary>
    [Parameter] public EventCallback<PendingPush> OnPush { get; set; }

    private static readonly PromotionAction[] Actions = Enum.GetValues<PromotionAction>();

    protected override void OnInitialized()
    {
        Observe(Vm, Vm.Leaves, Vm.PreviewLines, Vm.Destinations);

        foreach (var leaf in Vm.Leaves)
        {
            Observe(leaf);
        }
    }

    private static void OnAction(PromoteLeafVm leaf, ChangeEventArgs e) =>
        Choice.Set<PromotionAction>(e, action => leaf.Action = action);

    private static string Label(PromotionAction action) => action switch
    {
        PromotionAction.CopyVerbatim => "Copy verbatim",
        PromotionAction.CopyPlaceholder => "Placeholder",
        PromotionAction.Skip => "Skip",
        _ => action.ToString(),
    };

    /// <summary>
    /// Lands the promotion on the destination in memory and closes. Nothing is written here — the
    /// promoted keys join whatever else is unsaved, to be pushed when you are ready.
    /// </summary>
    private async Task Apply()
    {
        if (Vm.Apply())
        {
            await OnClose.InvokeAsync();
        }
    }
}
