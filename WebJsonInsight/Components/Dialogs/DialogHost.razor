@*
    Renders whichever dialog DialogService has open, and nothing when none is.

    One host rather than a modal per tab, for the same reason WPF puts ShowDialog in the window's
    code-behind: only one may be up at a time, and opening one has to close whichever was.
*@
@inherits ObservingComponent
@inject DialogService Dialogs

@if (Dialogs.Refusal is { } refusal)
{
    <Modal Title="Not possible" Wide="false" OnClose="Close">
        <ChildContent>
            <p class="refusal">@refusal</p>
        </ChildContent>
        <Footer>
            <span class="spacer"></span>
            <button class="btn btn-primary" @onclick="Close">OK</button>
        </Footer>
    </Modal>
}
else if (Dialogs.Edit is { } edit)
{
    <EditDialog Vm="edit" OnClose="Close" />
}
else if (Dialogs.Promote is { } promote)
{
    <PromoteDialog Vm="promote" OnClose="Close" />
}
else if (Dialogs.Changes is { } changes)
{
    <ChangesDialog Vm="changes" OnClose="Close" />
}
else if (Dialogs.RestartConfig is { } configuring)
{
    <RestartConfigDialog Row="configuring" OnClose="Close" />
}
else if (Dialogs.Restart is { } restart)
{
    <RestartCallDialog Vm="restart" OnClose="Close" />
}

@code {
    protected override void OnInitialized() => Dialogs.Changed += OnDialogsChanged;

    private void OnDialogsChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void Disposing() => Dialogs.Changed -= OnDialogsChanged;

    private void Close() => Dialogs.CloseAndRefresh();
}
