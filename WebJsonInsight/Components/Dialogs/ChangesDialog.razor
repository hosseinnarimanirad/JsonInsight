@*
    Unsaved changes — everything the app is holding that no source has been told about, reviewed one
    tier at a time before it becomes a version.

    Batching is not a convenience: the change that prompted the feature was one shape applied to six
    sibling Couchbase URLs across two environments, and six sequential single-key pushes would be six
    versions of a secret describing one change.

    This used to review a queue that existed nowhere else until it was pushed, and each entry carried
    the value it was made against so a read moving the tier underneath it could be caught. Edits land
    in the tier's own in-memory document now, so there is no queue to go stale — whether the source
    has moved since it was read is asked by the push screen, against the live secret or file.
*@
@inherits ObservingComponent

<Modal Title="@Vm.Title" Subtitle="@Vm.What" OnClose="OnClose">
    <ChildContent>
    
        <div class="changes">
    
            <div class="toolbar-row">
                <label for="changes-tier">Tier</label>
                <select id="changes-tier" class="field" value="@Vm.Tier?.Id"
                        @onchange="e => Vm.Tier = Vm.Tiers.FirstOrDefault(t => t.Id == e.Value?.ToString())">
                    @foreach (var tier in Vm.Tiers)
                    {
                        <option value="@tier.Id" selected="@(tier.Id == Vm.Tier?.Id)">@tier.Label</option>
                    }
                </select>
    
                <button class="btn btn-primary" @onclick="() => Vm.PreviewCommand.Execute(null)">Preview</button>
                <button class="btn btn-small" @onclick="() => Vm.DiscardTierCommand.Execute(null)"
                        title="Take this tier back to what its source last handed over.">Discard this tier's</button>
            </div>

            @foreach (var warning in Vm.Warnings)
            {
                <div class="notice notice-warn"><Icon Name="warn" /> <span>@warning</span></div>
            }
    
            @if (!string.IsNullOrEmpty(Vm.Message))
            {
                <div class="notice notice-info">@Vm.Message</div>
            }
    
            <div class="changes-body">
                <div class="card card-flush grid-card">
                    <div class="grid-scroll">
                        <table class="grid">
                            <thead>
                                <tr>
                                    <th class="col-path">KEY</th>
                                    <th style="width:74px">TIER</th>
                                    <th style="width:66px">KIND</th>
                                    <th class="col-tier">WAS</th>
                                    <th class="col-tier">BECOMES</th>
                                    <th style="width:76px"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var change in Vm.Changes)
                                {
                                    <tr @key="@($"{change.TierId}|{change.Path}")">
                                        <td class="col-path"><span class="path-label">@change.Path</span></td>
                                        <td>@change.TierId</td>
                                        <td>@change.KindName</td>
                                        <td class="col-tier @SecretClass(change)">@change.BaseDisplay</td>
                                        <td class="col-tier @SecretClass(change)">@change.NewDisplay</td>
                                        <td>
                                            <button class="btn btn-small" @onclick="() => Vm.DiscardCommand.Execute(change)"
                                                    title="Take this one path back to what the source last handed over.">Discard</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
    
                <div class="card card-flush grid-card">
                    <DiffLinesView Lines="Vm.PreviewLines" LeftHeader="AS IT IS"
                                   RightHeader="WITH THESE APPLIED" EmptyMessage="Press Preview." />
                </div>
            </div>
        </div>
    </ChildContent>

    <Footer>
        <span class="caption inline">
            One tier per press — one secret, one version, one typed confirmation — but every key for
            that tier in a single version.
        </span>
        <span class="spacer"></span>
        <button class="btn" @onclick="OnClose">Close</button>
        <button class="btn btn-danger" disabled="@(!Vm.CanPush)" @onclick="Push">
            <Icon Name="push" Size="13" /> <span>Push to Vault or disk…</span>
        </button>
    </Footer>
</Modal>

@code {
    [Parameter, EditorRequired] public ChangesVm Vm { get; set; } = default!;

    [Parameter] public EventCallback OnClose { get; set; }

    [Parameter] public EventCallback<PendingPush> OnPush { get; set; }

    protected override void OnInitialized()
    {
        Observe(Vm, Vm.Changes, Vm.PreviewLines, Vm.Warnings, Vm.Tiers);

        foreach (var change in Vm.Changes)
        {
            Observe(change);
        }
    }

    private static string SecretClass(ChangeRowVm change) =>
        change.Class == JsonInsight.Model.ValueClass.Secret ? "cell-secret" : string.Empty;

    private async Task Push()
    {
        if (Vm.PendingPush() is { } pending)
        {
            await OnPush.InvokeAsync(pending);
        }
    }
}
