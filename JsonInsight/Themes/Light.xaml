<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces and chrome. Same token names as DiskLens so the two apps read as one family. -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F3F5F9" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#EBEFF5" />
    <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#EDF1F8" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#DEE9FC" />
    <SolidColorBrush x:Key="Brush.Border" Color="#DBE1EA" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#E9EDF3" />

    <SolidColorBrush x:Key="Brush.Text" Color="#141C26" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5A6675" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#8894A3" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#2E6FE0" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#4685EE" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#255CBC" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#E4EDFD" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

    <SolidColorBrush x:Key="Brush.Track" Color="#E6EAF1" />
    <SolidColorBrush x:Key="Brush.Scroll" Color="#B9C2CE" />
    <SolidColorBrush x:Key="Brush.Danger" Color="#D2413F" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FBE7E7" />

    <!-- The four findings colours. These carry the whole tool: red = a key a tier does not have,
         amber = a shape too different to compare, blue = present on both sides but not equal,
         green = agreement. Every one has a soft partner used as a row or cell wash. -->
    <SolidColorBrush x:Key="Brush.Missing" Color="#C93B39" />
    <SolidColorBrush x:Key="Brush.MissingSoft" Color="#FBE7E7" />
    <SolidColorBrush x:Key="Brush.Shape" Color="#A06400" />
    <SolidColorBrush x:Key="Brush.ShapeSoft" Color="#FCF2DE" />
    <SolidColorBrush x:Key="Brush.Differs" Color="#1F6FB2" />
    <SolidColorBrush x:Key="Brush.DiffersSoft" Color="#E6F1FA" />
    <SolidColorBrush x:Key="Brush.Ok" Color="#2E7D46" />
    <SolidColorBrush x:Key="Brush.OkSoft" Color="#E7F4EB" />

    <!-- Masked values. Distinct from every findings colour: a secret is a rendering rule, not a finding. -->
    <SolidColorBrush x:Key="Brush.Secret" Color="#7A4FBF" />

    <!-- Find matches in the editor pane. A rendering rule like the one above rather than a finding,
         so it gets its own hue: amber here would read as the "shape" finding and as the "edited"
         mark, and a search hit is neither. Soft on every match, strong on the one Enter is on. -->
    <SolidColorBrush x:Key="Brush.FindSoft" Color="#FFF3B8" />
    <SolidColorBrush x:Key="Brush.Find" Color="#FFC94D" />

</ResourceDictionary>
