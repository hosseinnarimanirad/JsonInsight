<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:diff="clr-namespace:JsonInsight.Diff;assembly=JsonInsight.Core"
                    xmlns:views="clr-namespace:JsonInsight.Views">

    <!-- The surviving converters, all layout or logic and never colour. They live here rather than
         in App.xaml so that anything merging this dictionary - the app, a designer, the UI smoke
         test - gets a complete set. -->
    <views:BoolToVisibilityConverter x:Key="BoolVis" />
    <views:NotEmptyToVisibilityConverter x:Key="NotEmptyVis" />
    <views:InverseBooleanConverter x:Key="NotBool" />
    <views:IndentConverter x:Key="Indent" />

    <!--
        Every colour here is a DynamicResource. That is what makes the night mode work: ThemeManager
        swaps the colour dictionary underneath and each control repaints, with no rebinding and no
        rebuilt view models. A StaticResource colour in this file would freeze at whatever theme
        happened to load first, so there are none.
    -->

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Config paths and values are compared character by character, so they are always monospaced. -->
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="Size.Mono">12</sys:Double>

    <!-- ============================== Text ============================== -->

    <Style x:Key="Text.Base" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    </Style>

    <Style x:Key="Text.Title" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Heading" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Secondary" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <Style x:Key="Text.SectionLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <Style x:Key="Text.Icon" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Text.Mono" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Text.MonoCaption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Mono}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- Semantic text. One style per findings colour, so a colour is never typed into a view. -->
    <Style x:Key="Text.Missing" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Missing}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style x:Key="Text.Shape" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Shape}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--
        Value class drives the foreground of a rendered value: a secret is purple wherever it
        appears, deployment-specific infra is dimmed, business values get full contrast because
        those are the ones a mismatch actually matters for. Bound to 'Class' on the row.
    -->
    <Style x:Key="Text.Mono.ByClass" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Mono}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Class}" Value="Secret">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Secret}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Class}" Value="Infra">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The same rule where the row wraps the leaf rather than being one (the promote dialog). -->
    <Style x:Key="Text.ByLeafClass" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Leaf.Class}" Value="Secret">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Secret}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Leaf.Class}" Value="Infra">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- And where the row carries the class itself, with no leaf behind it: an edit row exists for
         tiers that do not have the key at all, so there is nothing to reach Leaf.Class through. -->
    <Style x:Key="Text.ByClass" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Class}" Value="Secret">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Secret}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Class}" Value="Infra">
                <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================ Surfaces ============================ -->

    <Style x:Key="Card" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- A card that hosts a list or grid edge to edge: no padding, so the content reaches the corners. -->
    <Style x:Key="Card.Flush" TargetType="{x:Type Border}" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- Column-header strip inside a flush card. Radius matches the card's top corners. -->
    <Style x:Key="TableHeader" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="CornerRadius" Value="11,11,0,0" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Notice strips: an amber one for the staleness warning, a red one for load problems. -->
    <Style x:Key="Notice.Warn" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.ShapeSoft}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="Notice.Danger" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- Counter pill for the missing / differs / expected headline numbers. -->
    <Style x:Key="Pill" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================= Buttons ============================ -->

    <!--
        One height for every interactive control in the app, and one for the dense variants.

        These are here rather than spelled into each style because the alternative was what this app
        had: a button 34px tall beside a field of 32 beside a search box of 19, each arrived at by a
        different padding, and no way to change the density of the app without finding all of them.
        Padding now sets the horizontal breathing room and these set the height, so a button and the
        field next to it line up by construction rather than by coincidence.
    -->
    <sys:Double x:Key="Size.Control">28</sys:Double>
    <sys:Double x:Key="Size.Control.Dense">23</sys:Double>

    <Style x:Key="Button.Base" TargetType="{x:Type ButtonBase}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="13,4" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Button.Primary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Secondary" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Anything unstyled falls back to Secondary rather than to the Windows chrome. -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}" />

    <Style x:Key="Button.Ghost" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Button.Icon" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="{StaticResource Size.Control}" />
        <Setter Property="Height" Value="{StaticResource Size.Control}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!--
        The clear affordance inside a field. Sized to the field's inner height rather than to a
        button's: it lives between the border and the text, so anything with a button's padding
        would push the field taller than the row it sits in.
    -->
    <Style x:Key="Button.Ghost.Tiny" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="Padding" Value="0" />
        <!-- 18, not a button's natural size: these fields have no vertical padding of their own, so
             anything taller than the text inside them grows every search box in the app. -->
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
        <Setter Property="FontSize" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
    </Style>

    <!-- Small, quiet action that sits inside a dense row (promote, swap, copy). -->
    <Style x:Key="Button.Small" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control.Dense}" />
        <Setter Property="FontSize" Value="11.5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Danger is reserved for the one irreversible action in the app - writing a snapshot. It stays
        soft until hover so it is legible as "this is the destructive one" without shouting.
    -->
    <Style x:Key="Button.Danger" TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Input ============================= -->

    <Style x:Key="Field.Base" TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <!-- Vertical padding only has to clear the text; Size.Control decides the height. A
             multi-line field overrides both, and should - the pane is not a row control. -->
        <Setter Property="Padding" Value="9,4" />
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <!-- These three are template-bound rather than fixed. Hard-coding them made
                             the one-line fields look right while leaving a multi-line box unable to
                             top-align or scroll at all, whatever it asked for. The Setter above
                             still says Center and the defaults are still Hidden, so every field
                             that was not asking for anything else is unchanged. -->
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Scroll}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Paths and secret paths are typed and compared literally, so those fields are monospaced. -->
    <Style x:Key="TextBox.Mono" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
    </Style>

    <!--
        The same field on one line of a row.

        The only difference is that it does not stretch. A field left to fill its cell takes the
        height of the tallest thing on the row - a button, a two-line label - and then reads as the
        loudest thing on it. Centring makes it ask for its natural height instead, which
        Size.Control has already fixed at the same height as the buttons beside it.

        This replaced a near-identical TextBox.Cell whose only distinction was 1px of padding.
    -->
    <Style x:Key="TextBox.Inline" TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBox.Mono}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Filter field. The hint comes from Tag, which is the only string a TextBox carries that is
        not its value - without it an empty filter box is just an unexplained rectangle, and these
        three boxes each filter by something different.
    -->
    <Style x:Key="TextBox.Search" TargetType="{x:Type TextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding Path=(views:SearchBox.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       Foreground="{DynamicResource Brush.TextTertiary}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />

                            <Grid Grid.Column="1">
                                <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}"
                                           Foreground="{DynamicResource Brush.TextTertiary}"
                                           VerticalAlignment="Center" Margin="8,0,6,0"
                                           TextTrimming="CharacterEllipsis"
                                           IsHitTestVisible="False" Visibility="Collapsed" />
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="8,0,6,0"
                                              VerticalAlignment="Center"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden" />
                            </Grid>

                            <!-- Clearing a filter is the second most common thing done to one, and
                                 select-all-delete is a poor way to offer it. Hidden while the field
                                 is empty, so an empty box is still a plain box. -->
                            <Button x:Name="Clear" Grid.Column="2"
                                    Style="{StaticResource Button.Ghost.Tiny}"
                                    Content="&#xE711;"
                                    Command="{x:Static views:SearchBox.ClearCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    ToolTip="Clear" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Clear" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Scroll}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource Field.Base}">
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type PasswordBox}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Scroll}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="5"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Scroll}"
                                BorderThickness="1"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True">
                            <Path x:Name="Tick"
                                  Data="M 0,4.2 L 3.2,7.4 L 8.6,1.2"
                                  Stroke="{DynamicResource Brush.OnAccent}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed" />
                        </Border>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        A standing filter that sits beside a search box. A switch rather than a tick box because it
        is a mode you leave on, and one left on is why a tree looks half empty an hour later - the
        shape has to say "still on" from across the room. Sized to stand level with the field next
        to it.
    -->
    <Style x:Key="Switch.Filter" TargetType="{x:Type CheckBox}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="Root" CornerRadius="7" Padding="8,0"
                            MinHeight="{StaticResource Size.Control}"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="Track" Width="26" Height="15" CornerRadius="8"
                                    Background="{DynamicResource Brush.Track}"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Knob" Width="11" Height="11" Margin="2,0,0,0"
                                         Fill="{DynamicResource Brush.Surface}"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="7,0,1,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Brush.OnAccent}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.AccentSoft}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Scroll}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ComboBox.Toggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Root"
                            Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                        <TextBlock x:Name="Chevron" Text="&#xE70D;"
                                   FontFamily="{StaticResource Font.Icons}" FontSize="9"
                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Margin="0,0,10,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6"
                            Padding="{TemplateBinding Padding}" Margin="0,1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource Field.Base}">
        <!-- Horizontal only; the height comes from Field.Base like every other field. -->
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBox}">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboBox.Toggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />

                        <!-- All four properties, as in WPF's own template: SelectionBoxItemTemplate
                             is what carries DisplayMemberPath through to the closed combo, and
                             without the pair the box falls back to ToString() on the item. -->
                        <ContentPresenter x:Name="Selected"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          IsHitTestVisible="False" />

                        <!--
                            The editable half. WPF looks this part up by name and drives it itself;
                            a template without it makes IsEditable="True" silently do nothing, which
                            is why the earlier version of this app could only offer a dropdown OR a
                            text field and never both in one control.

                            It sits on top of the presenter above and hides it, rather than the two
                            being alternatives, so a non-editable combo is unaffected by any of this.
                        -->
                        <TextBox x:Name="PART_EditableTextBox"
                                 Visibility="Collapsed"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="{TemplateBinding Padding}"
                                 Margin="0,0,26,0"
                                 MinHeight="0"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{TemplateBinding FontSize}"
                                 Foreground="{TemplateBinding Foreground}"
                                 CaretBrush="{DynamicResource Brush.Text}"
                                 SelectionBrush="{DynamicResource Brush.Accent}"
                                 VerticalContentAlignment="Center"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" />

                        <Popup x:Name="PART_Popup" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False"
                               PopupAnimation="Fade"
                               MinWidth="{TemplateBinding ActualWidth}">
                            <Border Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="8"
                                    Padding="4" Margin="0,4,0,0"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Selected" Property="Visibility" Value="Collapsed" />
                            <!-- A field you type into is a caret, not a hand. -->
                            <Setter Property="Cursor" Value="IBeam" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A path field that also offers what was found in Vault. Monospaced, because these are
         compared literally, and editable, because the list is a convenience rather than the
         authority: a secret the token cannot list must still be reachable by typing it. -->
    <Style x:Key="ComboBox.Path" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="IsEditable" Value="True" />
        <Setter Property="IsTextSearchEnabled" Value="False" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="{StaticResource Size.Mono}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================== Tabs ============================== -->

    <!-- A segmented control rather than a filing-cabinet tab strip: five destinations, one visible
         selection, and the same 7px radius language as the buttons. -->
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="7"
                            Padding="16,7" Margin="1,0" SnapsToDevicePixels="True">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" HorizontalAlignment="Left"
                                Background="{DynamicResource Brush.SurfaceAlt}"
                                CornerRadius="9" Padding="3" Margin="0,0,0,10">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =========================== Scroll bars ========================== -->

    <Style x:Key="ScrollBar.PageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBar.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Bar"
                            Background="{DynamicResource Brush.Scroll}"
                            CornerRadius="3"
                            Margin="3"
                            Opacity="0.55" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="0.95" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBar.PageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollBar.PageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBar.PageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollBar.Thumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollBar.PageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ============================== Lists ============================= -->

    <Style x:Key="EntryItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="7"
                            Padding="10,6" SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Selected}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="EntryList" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource EntryItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
    </Style>

    <!--
        Row container for the diff and compare lists. Deliberately has no hover or selection wash:
        those rows carry a findings colour of their own, and a highlight on top of it would read as
        a different finding.
    -->
    <Style x:Key="LineItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LineList" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource LineItem}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
    </Style>

    <!-- ============================ Data grid =========================== -->

    <Style TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Border Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}"
                            BorderThickness="0,0,1,1"
                            Padding="10,8">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type DataGridCell}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSubtle}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type DataGrid}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="RowHeight" Value="30" />
        <Setter Property="EnableRowVirtualization" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- ======================== Findings colouring ====================== -->

    <!--
        One tier's value for one path. Missing and shape-mismatch get a wash plus a coloured
        foreground; everything else stays plain so the eye lands only on the findings. The trigger
        is on the cell's own State, which is why this template can be reused by every generated
        tier column without the colour logic being duplicated per column.
    -->
    <DataTemplate DataType="{x:Type diff:MultiCell}">
        <Border x:Name="Wash" Padding="7,2" CornerRadius="5" HorizontalAlignment="Stretch"
                Background="Transparent">
            <TextBlock x:Name="Value" Text="{Binding Display}"
                       FontFamily="{StaticResource Font.Mono}"
                       FontSize="{StaticResource Size.Mono}"
                       Foreground="{DynamicResource Brush.Text}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Detail}" />
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Missing">
                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource Brush.MissingSoft}" />
                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Missing}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Shape">
                <Setter TargetName="Wash" Property="Background" Value="{DynamicResource Brush.ShapeSoft}" />
                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Shape}" />
            </DataTrigger>
            <!-- Vault could not be read for this tier, so nothing is known about this key in it.
                 Deliberately quiet rather than red: it is the absence of a finding, and a column of
                 unknowns painted like a column of gaps would read as hundreds of missing keys. -->
            <DataTrigger Binding="{Binding State}" Value="Unavailable">
                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                <Setter TargetName="Value" Property="ToolTip"
                        Value="Vault could not be read for this tier, so this key is unknown in it — not missing from it." />
            </DataTrigger>
            <DataTrigger Binding="{Binding Leaf.Class}" Value="Secret">
                <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Secret}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Background wash for one line of a text diff, keyed on DiffPlex's change type. -->
    <Style x:Key="Row.DiffLine" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0,1" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="Inserted">
                <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="Deleted">
                <Setter Property="Background" Value="{DynamicResource Brush.MissingSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type}" Value="Modified">
                <Setter Property="Background" Value="{DynamicResource Brush.DiffersSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        The JSON editor's own comparison, which is a document against the state *you* opened it in
        rather than one tier against another. Its three colours therefore have to mean what the
        tree's markers beside it mean - green added, red removed, amber edited - so modified rows
        take the amber wash here instead of the blue one that reads as "these two tiers differ".
    -->
    <Style x:Key="Row.EditDiffLine" TargetType="{x:Type Border}" BasedOn="{StaticResource Row.DiffLine}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Type}" Value="Modified">
                <Setter Property="Background" Value="{DynamicResource Brush.ShapeSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Background wash for one row of the JSON compare, keyed on the kind of difference. -->
    <Style x:Key="Row.DiffKind" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,4" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="OnlyInLeft">
                <Setter Property="Background" Value="{DynamicResource Brush.MissingSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="OnlyInRight">
                <Setter Property="Background" Value="{DynamicResource Brush.MissingSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ShapeDiffers">
                <Setter Property="Background" Value="{DynamicResource Brush.ShapeSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ValueDiffers">
                <Setter Property="Background" Value="{DynamicResource Brush.DiffersSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="TypeDiffers">
                <Setter Property="Background" Value="{DynamicResource Brush.DiffersSoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="SetDiffers">
                <Setter Property="Background" Value="{DynamicResource Brush.DiffersSoft}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The matching status word for that row. -->
    <Style x:Key="Text.DiffKind" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="OnlyInLeft">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Missing}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="OnlyInRight">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Missing}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ShapeDiffers">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Shape}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="ValueDiffers">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Differs}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="TypeDiffers">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Differs}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="SetDiffers">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Differs}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============================= Popups ============================= -->

    <Style TargetType="{x:Type ToolTip}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="MaxWidth" Value="460" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToolTip}">
                    <Border Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,7">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <Border Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <!--
                    The tick column is not decoration. This template used to render the header and
                    nothing else, so a checkable item showed no state at all: IsChecked was bound,
                    read and written correctly, and the screen said nothing either way. Anything
                    checkable in a menu has to look checked.
                -->
                <ControlTemplate TargetType="{x:Type MenuItem}">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="Tick" Grid.Column="0" Text="&#xE73E;"
                                       FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                       Foreground="{DynamicResource Brush.Accent}"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       Visibility="Collapsed" />

                            <ContentPresenter Grid.Column="1" ContentSource="Header"
                                              VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hidden rather than Collapsed on a checkable item, so ticking one does
                             not shunt its own label sideways while the menu is open. A plain item
                             keeps Collapsed and is not indented past a tick it can never show. -->
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Hidden" />
                        </Trigger>

                        <!-- After IsCheckable on purpose: for one property, the last trigger wins. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type GridSplitter}">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- ============================= Window ============================= -->

    <Style TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

</ResourceDictionary>
