<UserControl x:Class="JsonInsight.Views.JsonEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JsonInsight.ViewModels;assembly=JsonInsight.Presentation"
             xmlns:views="clr-namespace:JsonInsight.Views"
             d:DataContext="{d:DesignInstance Type=vm:JsonEditorVm}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             PreviewKeyDown="OnPaneKeyDown">

    <DockPanel>
        <!-- Toolbar: which tier, and everything that acts on the document as a whole. -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <TextBlock Text="Tier" Style="{StaticResource Text.Base}"
                                   VerticalAlignment="Center" Margin="0,0,9,0" />
                        <!-- The version is in the list rather than beside it: which version you are
                             about to edit is part of choosing what to edit, since an edit is built
                             against one and a push is refused when somebody has replaced it since. -->
                        <ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding Tier}"
                                  DisplayMemberPath="PickerLabel" MinWidth="230"
                                  ToolTip="Which source to edit, and which version of it is loaded." />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- The glyph is its own TextBlock in the icon font, not a character sitting
                             in Content beside the label. Every button style here descends from
                             Button.Base, which sets Font.Ui, and a text font has nothing at these
                             private-use codepoints - a glyph left in Content renders as the
                             missing-glyph rectangle. Switching the whole button to Font.Icons was
                             the other way out and is worse: the label would then be set in an icon
                             font too, so it takes two elements. Same shape as the Push button below,
                             and as Redo, Copy and the Comparing state. The glyph is sized to the
                             style it sits in - 11.5 for Button.Small - so it sits on the label's
                             own line rather than riding above it. -->
                        <Button Style="{StaticResource Button.Small}"
                                Command="{Binding UndoCommand}" IsEnabled="{Binding CanUndo}"
                                Margin="0,0,6,0" ToolTip="Undo the last replacement">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource Font.Icons}" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Undo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Small}"
                                Command="{Binding RedoCommand}" IsEnabled="{Binding CanRedo}"
                                Margin="0,0,6,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A6;" FontFamily="{StaticResource Font.Icons}" FontSize="11.5"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Redo" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Small}" Content="Revert all"
                                Command="{Binding RevertAllCommand}" IsEnabled="{Binding IsModified}"
                                Margin="0,0,6,0"
                                ToolTip="Back to the state this tier was opened in. Itself undoable." />
                        <!-- A mode, not an action, so the button stays lit while it is on. A
                             DataTrigger cannot swap the Style it lives in, so the on-state is
                             painted with the same accent brushes Button.Primary uses. -->
                        <Button Command="{Binding ToggleComparisonCommand}"
                                MinWidth="176" IsEnabled="{Binding CanCompare}"
                                ToolTip="Diff the selected node against the state it was opened in — the root row is the whole document. Press again to go back to the editor. Disabled for a node with nothing to compare.">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                    <Setter Property="Content">
                                        <Setter.Value>Compare with original</Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowingComparison}" Value="True">
                                            <!-- The tick needs the icon font for the reason given at
                                                 Undo above, so the on-state content is a panel and
                                                 the off-state stays a plain string. -->
                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock Text="Comparing" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource Text.Caption}"
                               VerticalAlignment="Center" Margin="18,0,18,0"
                               TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <!-- dev is readable here and never writable; saying why beats a greyed-out button. -->
                <Border Style="{StaticResource Notice.Warn}" Margin="0,11,0,0"
                        Visibility="{Binding ReadOnlyReason, Converter={StaticResource NotEmptyVis}}">
                    <TextBlock Text="{Binding ReadOnlyReason}" Foreground="{DynamicResource Brush.Shape}"
                               FontSize="12" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </Border>

        <!-- Push bar. There is no Save beside it, and nothing missing: a tier is a Vault secret, so
             the only place an edit can go is back into it. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0"
                Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="PushButton" Style="{StaticResource Button.Danger}"
                        MinWidth="170" Click="OnPushClick" Margin="8,0,0,0"
                        IsEnabled="{Binding CanPush}" ToolTip="{Binding PushHint}"
                        ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="Push to Vault or disk" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- What the button would do, or why it will not. A greyed button that keeps its
                     reason to itself is one you press twice and then go looking for a bug. -->
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Top"
                               Margin="0,2,8,0" />
                    <TextBlock Text="{Binding PushHint}" Style="{StaticResource Text.Secondary}"
                               FontSize="12" TextWrapping="Wrap" MaxWidth="1050" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Notice.Danger}" Margin="0,10,0,0"
                Visibility="{Binding Error, Converter={StaticResource NotEmptyVis}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource Brush.Danger}"
                       FontSize="12" TextWrapping="Wrap" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="280" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>

            <!-- The hierarchy -->
            <Border Grid.Column="0" Style="{StaticResource Card.Flush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource Button.Small}" Content="Expand"
                                        Command="{Binding ExpandAllCommand}" Margin="0,0,4,0" />
                                <Button Style="{StaticResource Button.Small}" Content="Collapse"
                                        Command="{Binding CollapseAllCommand}" />
                            </StackPanel>
                            <TextBlock Text="HIERARCHY" Style="{StaticResource Text.SectionLabel}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Padding="10,9"
                            Background="{DynamicResource Brush.Surface}">
                        <StackPanel>
                            <!-- The standing filter shares the search box's row, so the two read as
                                 one control: "changed only, matching this". A switch rather than a
                                 tick box because it is a mode you leave on, and one left on is the
                                 reason a tree looks half empty an hour later. -->
                            <DockPanel>
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch.Filter}"
                                          Content="Changed" Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding ShowChangedOnly}"
                                          ToolTip="Show only the nodes you have edited, with the sections above them so the tree still navigates. Combines with the search." />

                                <TextBox Style="{StaticResource TextBox.Search}" Tag="Search paths…"
                                         ToolTip="Path substring, or a glob once it contains a * — for example **:*Password"
                                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=250}" />
                            </DockPanel>

                            <!-- Says why the tree is empty, which is otherwise indistinguishable
                                 from something being broken. -->
                            <TextBlock Text="{Binding FilterHint}" Style="{StaticResource Text.Caption}"
                                       Margin="0,7,0,0" TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding FilterHint, Converter={StaticResource NotEmptyVis}}" />
                        </StackPanel>
                    </Border>

                    <ListBox x:Name="Tree" Style="{StaticResource EntryList}"
                             ItemsSource="{Binding Nodes}"
                             SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal"
                                            Margin="{Binding Indent, Converter={StaticResource Indent}}">
                                    <TextBlock Text="{Binding Glyph}" Width="14"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Center" />

                                    <!-- Unsaved-change marker, and which kind of change it is: green
                                         + added, amber pencil edited, red − removed. A section that
                                         merely holds changes keeps the blue * — it may hold all
                                         three at once, and claiming it is any one of them would be
                                         a lie told at exactly the level you are scanning.

                                         A fixed-width cell rather than an inline character, so a
                                         marked row does not sit one glyph wider than its unmarked
                                         siblings and break the column. -->
                                    <TextBlock Width="15" FontWeight="Bold"
                                               VerticalAlignment="Center" TextAlignment="Left"
                                               ToolTip="{Binding ChangedTooltip}"
                                               Visibility="{Binding IsChanged, Converter={StaticResource BoolVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="*" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Differs}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Change}" Value="Added">
                                                        <Setter Property="Text" Value="+" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                                    </DataTrigger>
                                                    <!-- The pencil is the one marker with no legible
                                                         ASCII form, so this row alone borrows the
                                                         icon font. -->
                                                    <DataTrigger Binding="{Binding Change}" Value="Edited">
                                                        <Setter Property="Text" Value="&#xE70F;" />
                                                        <Setter Property="FontFamily" Value="{StaticResource Font.Icons}" />
                                                        <Setter Property="FontSize" Value="9" />
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Shape}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Change}" Value="Removed">
                                                        <Setter Property="Text" Value="&#x2212;" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Missing}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Width="15" VerticalAlignment="Center"
                                               Visibility="{Binding IsChanged, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />

                                    <!-- The name carries the same colour, so the kind of change is
                                         readable at a glance rather than only from a 12px marker.
                                         Struck through and red for a pending removal: the standard
                                         rendering, and the only one that reads as "gone but not yet
                                         committed". -->
                                    <TextBlock VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                                <Setter Property="Text" Value="{Binding Name}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Change}" Value="Mixed">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Differs}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Change}" Value="Added">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Change}" Value="Edited">
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Shape}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Change}" Value="Removed">
                                                        <Setter Property="FontWeight" Value="Normal" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Missing}" />
                                                        <Setter Property="TextDecorations" Value="Strikethrough" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding Summary, Converter={StaticResource NotEmptyVis}}" />
                                    <TextBlock Text="{Binding Preview}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MaxWidth="240"
                                               Visibility="{Binding Preview, Converter={StaticResource NotEmptyVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.MonoCaption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ContainsSecret}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Secret}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" />

            <!-- The editor, or the comparison -->
            <Border Grid.Column="2" Style="{StaticResource Card.Flush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        Visibility="{Binding ShowingComparison, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                                <!-- The display modes are switches rather than buttons, because they
                                     are states you leave set: a button labelled with its own current
                                     state has to be read before it can be pressed, and reads as an
                                     action either way. They match the Changed switch on the tree. -->
                                <CheckBox Style="{StaticResource Switch.Filter}" Content="Compact"
                                          IsChecked="{Binding CompactJson}" Margin="0,0,5,0"
                                          ToolTip="Show the pane as single-line JSON instead of indented. Display only — nothing compact is ever written, and switching mid-edit reformats what is in the pane rather than reloading the node." />

                                <CheckBox Style="{StaticResource Switch.Filter}" Content="Wrap"
                                          IsChecked="{Binding WordWrap}" Margin="0,0,5,0"
                                          ToolTip="Wrap long lines instead of letting them run off with a horizontal scrollbar. On is for reading a 900-character token; off is for seeing the shape of a deep structure." />

                                <!-- Off while comparing: there is no editable text behind the diff
                                     to search, which the bar's own MultiDataTrigger already knows -
                                     but a switch you can flip that changes nothing on screen is
                                     worse than one that is plainly unavailable. -->
                                <CheckBox Style="{StaticResource Switch.Filter}" Content="Find"
                                          IsChecked="{Binding FindOpen}" Margin="0,0,5,0"
                                          Checked="OnFindToggled"
                                          IsEnabled="{Binding ShowingComparison, Converter={StaticResource NotBool}}"
                                          ToolTip="Find and replace inside this pane (Ctrl+F). F3 finds the next match, Shift+F3 the previous." />

                                <Button Style="{StaticResource Button.Small}"
                                        Command="{Binding CopyNodeCommand}" Margin="0,0,4,0"
                                        ToolTip="Copy this pane's JSON to the clipboard — exactly what is shown, edits included.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Font.Icons}" FontSize="11.5"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Copy" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource Button.Small}" Content="Reload node"
                                        Command="{Binding ReloadNodeCommand}" Margin="0,0,4,0"
                                        ToolTip="Throw away what is typed in this pane and show the node again as the document currently has it. It changes nothing in the document — Undo node changes is the one that does." />
                                <Button Style="{StaticResource Button.Small}" Content="Remove node"
                                        Command="{Binding RemoveNodeCommand}" Margin="0,0,4,0"
                                        IsEnabled="{Binding CanRemoveNode}"
                                        Visibility="{Binding SelectedIsRemoved, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                        ToolTip="Delete this node from the document. It stays in the tree, struck through, until you save." />

                                <!-- One action, two readings. Putting a deleted node back is not
                                     "undoing changes", so the label says which one this is - but it
                                     is the same button doing the same thing to the same node, so it
                                     is not dressed as a different one either. -->
                                <Button Command="{Binding RevertNodeCommand}" Margin="0,0,4,0"
                                        Content="{Binding RevertNodeLabel}"
                                        Visibility="{Binding CanRevertNode, Converter={StaticResource BoolVis}}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Danger}">
                                            <Setter Property="ToolTip" Value="Undo the changes already applied to this node, back to what it held when the tier was opened, leaving every other edit alone. Unlike Reload node, this changes the document." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedIsRemoved}" Value="True">
                                                    <Setter Property="ToolTip" Value="Put this node back. Removing it was never written to disk — nothing has been saved yet." />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>

                                <!-- ShowOnDisabled, because off is the state this tooltip is about:
                                     the default hides a tooltip on a disabled control, which is
                                     precisely when "why can I not press this" gets asked. -->
                                <Button Content="Update node" Command="{Binding ApplyCommand}"
                                        IsEnabled="{Binding CanApply}"
                                        ToolTipService.ShowOnDisabled="True">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                            <Setter Property="ToolTip" Value="Apply the JSON in the pane to this node. In memory only — Save writes it. Off while the pane matches the document, and while it does not parse." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasEditorProblem}" Value="True">
                                                    <Setter Property="ToolTip" Value="{Binding EditorProblem}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>

                            <!-- Names the comparison's scope while it is on: a node-scoped diff that
                                 does not say which node it is showing is indistinguishable from a
                                 stale one left over from the last selection. -->
                            <TextBlock Text="{Binding PaneHeader}" VerticalAlignment="Center"
                                       Style="{StaticResource Text.SectionLabel}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="This pane holds the selected node's whole subtree. Update node replaces that node with whatever is here — it is not a patch, and the keys it does not mention are gone." />
                        </DockPanel>
                    </Border>

                    <!-- Find and replace over the pane. It sits above the text rather than floating
                         over it, because a bar that covers the first lines of a 28 KB document hides
                         the match it just found. Hidden while comparing: there is no editable text
                         behind the diff to search. -->
                    <Border DockPanel.Dock="Top" Padding="10,8"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding FindOpen}" Value="True" />
                                            <Condition Binding="{Binding ShowingComparison}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <!-- One row. Two would push the text down by the height of a whole field for
                             a feature that is open most of the time it is used, and neither box
                             needs a label when it carries a hint and an icon of its own. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" x:Name="FindBox"
                                     Style="{StaticResource TextBox.Search}" Tag="Find"
                                     KeyDown="OnFindBoxKeyDown"
                                     Text="{Binding FindText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Enter finds the next match, Shift+Enter the previous, Escape closes." />

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0,0,0">
                                <!-- Off with nothing to step to. Pressing a lit button that does
                                     nothing is how a working search gets reported as broken. -->
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE70E;" FontSize="10"
                                        Click="OnFindPrevious" IsEnabled="{Binding HasMatches}"
                                        ToolTip="Previous match (Shift+F3)" />
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE70D;" FontSize="10"
                                        Margin="2,0,0,0" Click="OnFindNext" IsEnabled="{Binding HasMatches}"
                                        ToolTip="Next match (F3)" />

                                <!-- A flag that lights up rather than a tick box, so its state is
                                     readable at the glance you give a dense row. -->
                                <ToggleButton Style="{StaticResource Toggle.Small}" Content="Aa"
                                              IsChecked="{Binding MatchCase}"
                                              VerticalAlignment="Center" Margin="9,0,0,0"
                                              ToolTip="Match case. Worth turning on here — this file's key order treats Url and URL as two different keys." />

                                <!-- Fixed width: the count changes on every keystroke, and a status
                                     that resizes shoves the whole row sideways while you type. -->
                                <TextBlock Text="{Binding FindStatus}" Style="{StaticResource Text.Caption}"
                                           VerticalAlignment="Center" TextAlignment="Right"
                                           Width="78" Margin="8,0,9,0" />
                            </StackPanel>

                            <TextBox Grid.Column="2"
                                     Style="{StaticResource TextBox.Search}" Tag="Replace with"
                                     views:SearchBox.Glyph="&#xE70F;"
                                     KeyDown="OnFindBoxKeyDown"
                                     IsEnabled="{Binding IsEditorReadOnly, Converter={StaticResource NotBool}}"
                                     Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5,0,0,0">
                                <!-- CanReplace, not just "the pane is writable": with nothing found
                                     there is nothing to replace, and the button should say so. -->
                                <Button Style="{StaticResource Button.Secondary}" Content="Replace"
                                        Click="OnReplace" IsEnabled="{Binding CanReplace}"
                                        ToolTip="Replace the current match and move to the next one" />
                                <Button Style="{StaticResource Button.Secondary}" Content="Replace all"
                                        Click="OnReplaceAll" Margin="4,0,0,0"
                                        IsEnabled="{Binding CanReplace}"
                                        ToolTip="Replace every match in this pane. Still only in the pane — a section needs Update node afterwards." />
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10"
                                        Margin="7,0,0,0"
                                        Command="{Binding CloseFindCommand}" ToolTip="Close (Escape)" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- A tombstone shows what it held, read-only. There is nothing to edit until
                         it is put back, and that is one button away. -->
                    <Border DockPanel.Dock="Top" Padding="11,9"
                            Background="{DynamicResource Brush.MissingSoft}"
                            Visibility="{Binding SelectedIsRemoved, Converter={StaticResource BoolVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       Foreground="{DynamicResource Brush.Missing}" VerticalAlignment="Center"
                                       Margin="0,0,9,0" />
                            <TextBlock Foreground="{DynamicResource Brush.Missing}" FontSize="12"
                                       VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="700"
                                       Text="Removed, and not yet saved. This is what it held when the tier was opened — Restore node puts it back exactly." />
                        </StackPanel>
                    </Border>

                    <!-- This pane shows values in clear, credentials included. It has to: a subtree
                         cannot be retyped without being read. The hierarchy beside it still renders
                         secrets as fingerprints, which is the form worth scanning. -->
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}"
                               Style="{StaticResource Text.Secondary}" FontSize="12"
                               TextWrapping="Wrap" Margin="11,9"
                               Visibility="{Binding Message, Converter={StaticResource NotEmptyVis}}" />

                    <!-- Which of the two ways this pane commits - or, while the pane does not parse,
                         why Update node is off. A screen where some edits land as you type and
                         others wait for a button has to say which one you are in; working it out
                         from whether the button greyed itself out is not a design, and that goes
                         double for a button that is off because the text is unreadable.

                         One line rather than two, because only one of the two is ever true: a pane
                         that does not parse is not committing as you type either. -->
                    <Border DockPanel.Dock="Bottom" Padding="11,7"
                            Background="{DynamicResource Brush.SurfaceAlt}"
                            BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0"
                            Visibility="{Binding CommitHint, Converter={StaticResource NotEmptyVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE7BA;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIsScalar}" Value="True">
                                                <Setter Property="Text" Value="&#xE930;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                            </DataTrigger>

                                            <!-- Last, so it wins over the scalar tick: a scalar whose
                                                 pane does not parse is not landing as you type. -->
                                            <DataTrigger Binding="{Binding HasEditorProblem}" Value="True">
                                                <Setter Property="Text" Value="&#xE7BA;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Missing}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Text comes from the style rather than as an attribute: a local value
                                 wins over a setter, so the trigger below could never replace it. -->
                            <TextBlock TextWrapping="Wrap" MaxWidth="620" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                        <Setter Property="Text" Value="{Binding CommitHint}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasEditorProblem}" Value="True">
                                                <Setter Property="Text" Value="{Binding EditorProblem}" />
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Missing}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <!-- The find marks, behind the text rather than over it.

                             A TextBox cannot colour part of its own content, so the marks are a
                             second element in this cell holding nothing but backgrounds, with the
                             editor transparent on top of it. The surface brush moves here for the
                             same reason - the editor no longer paints one - and the radius matches
                             the one the field's own template draws, so the corners still line up.

                             This layer must stay first: siblings paint in order, and the whole point
                             is that the glyphs are drawn over the marks. It is also why the marks
                             are an ordinary child rather than an adorner, which would render above
                             the text and would not survive switching away from this tab. -->
                        <Border CornerRadius="7" Background="{DynamicResource Brush.Surface}"
                                Visibility="{Binding ShowingComparison, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                            <views:FindHighlightLayer x:Name="Highlights" Editor="{Binding ElementName=Editor}" />
                        </Border>

                        <!-- Wraps by default rather than scrolling sideways: these values include
                             tokens and PEM blocks hundreds of characters long, and reading one of
                             those a screen-width at a time is not reading it. The toggle is for the
                             opposite need - seeing the indentation of a deep structure without every
                             long value folding the shape out of it. Set through the style rather
                             than as attributes, because a local value would win over the trigger. -->
                        <TextBox x:Name="Editor"
                                 Visibility="{Binding ShowingComparison, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                                 Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged, Delay=250}"
                                 IsReadOnly="{Binding IsEditorReadOnly}"
                                 Background="Transparent"
                                 PreviewMouseLeftButtonUp="OnEditorClicked"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 VerticalContentAlignment="Stretch" Padding="10"
                                 VerticalScrollBarVisibility="Auto">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource TextBox.Mono}">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WordWrap}" Value="False">
                                            <Setter Property="TextWrapping" Value="NoWrap" />
                                            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <!-- Both sides, so a removed line has somewhere to appear and a changed one
                             shows what it changed from. DiffRow.Edit rather than DiffRow: this is a
                             document against the state you opened it in, so its colours are the
                             tree's - amber for edited - not the blue that means "two tiers differ".
                             Both templates are in Controls.xaml. -->
                        <ListBox Style="{StaticResource LineList}" Padding="4"
                                 Visibility="{Binding ShowingComparison, Converter={StaticResource BoolVis}}"
                                 ItemsSource="{Binding ComparisonLines}"
                                 ItemTemplate="{StaticResource DiffRow.Edit}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
