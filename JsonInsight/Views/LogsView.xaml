<UserControl x:Class="JsonInsight.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <!--
        Everything the app has said, kept rather than overwritten.

        This replaced a banner above the tabs. A banner is the right shape for one urgent sentence
        and the wrong one for this: a single undeclared array produces a line per source, so the
        thing meant to draw the eye instead took the top of the window and pushed the grid - the
        reason the app is open - below the fold. Its only control was Dismiss, so the choice was
        between losing the window and losing the findings. A tab keeps both.
    -->
    <DockPanel Margin="14">

        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}"
                        Content="Clear" Margin="10,0,0,0"
                        Height="{StaticResource Size.Control}"
                        Command="{Binding ClearCommand}"
                        IsEnabled="{Binding IsEmpty, Converter={StaticResource NotBool}}"
                        ToolTip="Empty the log. Safe: this is a record of what already happened, not the app's state - a reload or a pull says all of it again." />

                <TextBlock Style="{StaticResource Text.SectionLabel}" Text="LOG"
                           VerticalAlignment="Center" Margin="0,0,12,0" />

                <TextBlock Style="{StaticResource Text.Secondary}" FontSize="12"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{Binding Summary}" />
            </DockPanel>
        </Border>

        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                   Text="Nothing logged yet. Warnings, read failures and every status line land here."
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}}" />

        <Border Style="{StaticResource Card}" Padding="0"
                Visibility="{Binding IsEmpty, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                    BorderThickness="0,0,0,1" Padding="12,5">
                                <!-- Fixed columns for the time and the level so the messages line up
                                     and can be read down the page; the text wraps in its own column
                                     rather than under the timestamp. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="46" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Time}"
                                               FontFamily="{StaticResource Font.Mono}" FontSize="11"
                                               Foreground="{DynamicResource Brush.TextTertiary}"
                                               VerticalAlignment="Top" />

                                    <TextBlock Grid.Column="1" Text="{Binding LevelLabel}"
                                               FontSize="10" FontWeight="Bold"
                                               VerticalAlignment="Top">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextTertiary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LevelKey}" Value="warn">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Shape}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LevelKey}" Value="error">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2" Text="{Binding Text}"
                                               FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LevelKey}" Value="error">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
