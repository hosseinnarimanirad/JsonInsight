<UserControl x:Class="JsonInsight.Views.TiersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JsonInsight.ViewModels;assembly=JsonInsight.Presentation"
             d:DataContext="{d:DesignInstance Type=vm:TiersVm}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Section rail: jump straight to the area you care about, with its own finding counts. -->
        <Border Grid.Column="0" Style="{StaticResource Card.Flush}" Margin="0,0,12,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Small}"
                                Content="all" HorizontalAlignment="Right"
                                Command="{Binding ClearSectionCommand}"
                                ToolTip="Clear the section filter" />
                        <TextBlock Text="SECTIONS" Style="{StaticResource Text.SectionLabel}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- The last pull, one line per tier. It sits under the rail rather than in a popup
                     because "identical to local v6, skipped" is the normal answer and wants to stay
                     readable while you look at the grid. -->
                <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0"
                        Visibility="{Binding PullStatus, Converter={StaticResource NotEmptyVis}}">
                    <StackPanel>
                        <TextBlock Text="LAST PULL" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Text="{Binding PullStatus}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                        <ItemsControl ItemsSource="{Binding PullReport}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.MonoCaption}"
                                               TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ListBox Style="{StaticResource EntryList}"
                         ItemsSource="{Binding Sections}"
                         SelectedValue="{Binding SectionFilter, Mode=TwoWay}"
                         SelectedValuePath="Name">
                    <ListBox.ItemTemplate>
                        <!-- Two lines rather than one. Section names run long ("ConnectionStrings",
                             "PaymentSettings") and the counts are the reason to look at the rail
                             at all, so neither is allowed to squeeze the other into an ellipsis. -->
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Base}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Counts}" Margin="0,1,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasFindings}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Missing}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <!-- Toolbar -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBox Style="{StaticResource TextBox.Search}"
                             Tag="Filter by path — or a glob, e.g. **:Modules:*:Url"
                             Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                             MinWidth="300" MaxWidth="440" HorizontalAlignment="Left" />

                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                        <CheckBox Content="Show identical" IsChecked="{Binding ShowIdentical}" Margin="0,0,18,0" />
                        <CheckBox Content="Show expected (deployment-specific)"
                                  IsChecked="{Binding ShowExpected}" Margin="0,0,18,0" />
                        <Button Style="{StaticResource Button.Small}" Content="Expand all"
                                Command="{Binding ExpandAllCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource Button.Small}" Content="Collapse all"
                                Command="{Binding CollapseAllCommand}" />
                        <TextBlock Text="{Binding ShownLabel}" Style="{StaticResource Text.Caption}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>

                    <!-- Where the values came from. Pull from Vault sits in the title bar beside
                         Reload from disk; its per-tier report is still the LAST PULL card on the
                         rail, because that is where you are looking when you press it. -->
                    <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                        <Border Style="{StaticResource Pill}"
                                Background="{DynamicResource Brush.SurfaceAlt}">
                            <TextBlock Text="{Binding SourceLabel}" FontSize="12"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </Border>

                        <!-- The other direction. It sits beside the pill that says where these
                             values came from, because that is the sentence it completes: read from
                             Vault, changed here, written back. One tier at a time — a push is one
                             secret and one version, and the dialog is where the tier is chosen. -->
                        <Button Style="{StaticResource Button.Small}" Margin="10,0,0,0"
                                Click="OnPushClick"
                                ToolTip="Upload a tier to Vault, or write it back to its file, with any changes queued against it applied, after reviewing it against what that source holds right now. This is the write half of Pull from Vault or disk.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE898;" FontFamily="{StaticResource Font.Icons}"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Push a tier…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Pending changes. Loud on purpose: an unwritten change set is easy to walk
                         away from, and the whole point of batching is that it sits there until it
                         is reviewed as a whole. -->
                    <Border CornerRadius="8" Padding="11,8" Margin="0,11,0,0"
                            Background="{DynamicResource Brush.DiffersSoft}"
                            Visibility="{Binding HasPendingEdits, Converter={StaticResource BoolVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
                                    Content="Review and write" Click="OnReviewChangesClick" />
                            <TextBlock Text="{Binding PendingLabel}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Differs}" FontSize="12"
                                       FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Detail strip for the selected row -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0"
                    Visibility="{Binding SelectedRow, Converter={StaticResource NotEmptyVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedRow.Path}" Style="{StaticResource Text.Mono}"
                               FontWeight="SemiBold" TextTrimming="None" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedRow.Detail}" Style="{StaticResource Text.Secondary}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                               Visibility="{Binding SelectedRow.Detail, Converter={StaticResource NotEmptyVis}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                Visibility="{Binding SelectedRow.IsSecret, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                                   Foreground="{DynamicResource Brush.Secret}" VerticalAlignment="Center"
                                   Margin="0,0,7,0" />
                        <TextBlock Foreground="{DynamicResource Brush.Secret}" FontSize="12" TextWrapping="Wrap"
                                   Text="Secret — the value is never shown. The short hash lets you tell whether two tiers hold the same secret." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Columns after 'Path' are generated at runtime, one per configured tier, so adding
                 prod to tiers.json is all it takes to see a prod column. -->
            <Border Style="{StaticResource Card.Flush}">
                <DataGrid x:Name="Grid"
                          ItemsSource="{Binding Rows}"
                          SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                          RowHeight="28">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Style.Triggers>
                                <!-- A rolled-up subtree is the unit a promote acts on, so it is set
                                     apart from the leaves underneath it. -->
                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Background" Value="{DynamicResource Brush.SurfaceAlt}" />
                                </DataTrigger>
                                <!-- A row with an uncommitted edit against it. Last trigger wins,
                                     so this shows through on group rows too. -->
                                <DataTrigger Binding="{Binding HasPendingEdit}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.DiffersSoft}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="PATH" Width="390">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Margin="{Binding Indent, Converter={StaticResource Indent}}">
                                        <TextBlock Text="{Binding Glyph}" Width="14"
                                                   Foreground="{DynamicResource Brush.TextTertiary}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Mono}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}"
                                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding Summary, Converter={StaticResource NotEmptyVis}}" />
                                        <TextBlock Text="&#xE70F;" FontFamily="{StaticResource Font.Icons}"
                                                   FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Differs}"
                                                   ToolTip="This key has an uncommitted change queued against it"
                                                   Visibility="{Binding HasPendingEdit, Converter={StaticResource BoolVis}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="164">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Button.Small}" Content="Edit"
                                                Click="OnEditRowClick" Margin="0,0,4,0"
                                                Visibility="{Binding CanEdit, Converter={StaticResource BoolVis}}"
                                                ToolTip="Change or remove this key across the tiers" />
                                        <Button Style="{StaticResource Button.Small}" Content="Promote &#x2192;"
                                                Visibility="{Binding CanPromote, Converter={StaticResource BoolVis}}"
                                                Click="OnPromoteClick"
                                                ToolTip="Copy this subtree into a tier that does not have it" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
