<Window x:Class="JsonInsight.Views.ChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JsonInsight.ViewModels;assembly=JsonInsight.Presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:ChangesVm}"
        mc:Ignorable="d"
        Title="Pending changes" Height="880" Width="1280"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text}"
        Background="{DynamicResource Brush.Window}">

    <!-- One column, read top to bottom in the order the decision is made: which tier and where it
         goes, the keys it changes, the diff against what the source holds right now, then the typed
         confirmation. The push used to be a second window opened from this one, and this one had a
         preview of its own against the tier as it was read — two diffs answering one question, and
         only the live one is worth confirming against. -->
    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Tier" Style="{StaticResource Text.Base}"
                               VerticalAlignment="Center" Margin="0,0,9,0" />
                    <ComboBox ItemsSource="{Binding Tiers}" SelectedItem="{Binding Tier}"
                              DisplayMemberPath="Label" MinWidth="230" />

                    <Button Style="{StaticResource Button.Small}" Margin="14,0,0,0"
                            Content="{Binding CheckLabel}"
                            Command="{Binding CheckAgainCommand}"
                            ToolTipService.ShowOnDisabled="True"
                            ToolTip="Read what this would replace again, right now, and rebuild the comparison. This is a read — nothing is sent." />
                    <Button Style="{StaticResource Button.Small}" Content="Discard this tier's changes"
                            Command="{Binding DiscardTierCommand}" Margin="6,0,0,0" />

                    <TextBlock Style="{StaticResource Text.Caption}" VerticalAlignment="Center"
                               Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="560"
                               Text="One tier per push — one destination, one typed confirmation. Every key for that tier goes in a single write." />
                </StackPanel>

                <!-- Where this lands, shown before anything is typed rather than in a tooltip. The
                     push's own description once there is one to make; before that — a read-only
                     tier, or nothing left — the reason there is nowhere to push it. -->
                <Border CornerRadius="8" Padding="11,8" Margin="0,11,0,0"
                        Background="{DynamicResource Brush.SurfaceAlt}"
                        DataContext="{Binding Push}"
                        Visibility="{Binding Converter={StaticResource NotEmptyVis}}">
                    <StackPanel>
                        <TextBlock Text="DESTINATION" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Text="{Binding Destination}" Style="{StaticResource Text.Mono}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                        <TextBlock Text="{Binding What}" Style="{StaticResource Text.Base}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"
                                   Visibility="{Binding What, Converter={StaticResource NotEmptyVis}}" />
                        <TextBlock Text="{Binding SourceLine}" Style="{StaticResource Text.Caption}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding SourceLine, Converter={StaticResource NotEmptyVis}}" />
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Push}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding TargetDescription}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icons}" FontSize="12"
                               Foreground="{DynamicResource Brush.TextTertiary}" VerticalAlignment="Top"
                               Margin="0,2,8,0" />
                    <TextBlock Text="{Binding TargetDescription}" Style="{StaticResource Text.Secondary}"
                               FontSize="12" TextWrapping="Wrap" MaxWidth="1100" />
                </StackPanel>

                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}"
                           FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                           Visibility="{Binding Message, Converter={StaticResource NotEmptyVis}}" />

                <!-- What the pushes made from this window reported. They outlive the tier they were
                     about, because the window moves on to the next one as soon as one goes through. -->
                <ItemsControl ItemsSource="{Binding PushReport}" Margin="0,6,0,0"
                              Visibility="{Binding PushReport.Count, Converter={StaticResource NotEmptyVis}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Style="{StaticResource Text.MonoCaption}"
                                       TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Action bar: the typed confirmation, then the one button that leaves this machine. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0">
            <DockPanel>
                <!-- ShowOnDisabled, because a refused push is the state this most needs to explain:
                     when the source has moved, the tooltip carries the whole sentence saying so. -->
                <Button DockPanel.Dock="Right"
                        MinWidth="150" Command="{Binding PushCommand}"
                        IsEnabled="{Binding CanPushNow}" Margin="8,0,0,0"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Danger}">
                            <Setter Property="ToolTip" Value="Write it. The payload is re-parsed before it leaves, the write carries the version read a moment ago as a check-and-set, and the result is read back and compared." />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Push.IsStale, FallbackValue=False}" Value="True">
                                    <Setter Property="ToolTip" Value="{Binding Push.Stale}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE898;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Push to Vault or disk" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Push.Busy, FallbackValue=False}" Value="True">
                                            <Setter Property="Text" Value="Working…" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>

                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Close"
                        MinWidth="100" Click="OnCloseClick" Margin="0,0,8,0" />

                <!-- Scoped to the push, so with nothing to push there is nothing here to bind. -->
                <StackPanel Orientation="Horizontal" DataContext="{Binding Push}">
                    <TextBlock Style="{StaticResource Text.Base}" VerticalAlignment="Center"
                               Margin="0,0,9,0" Text="Type the tier name to confirm:" />

                    <!-- Off until there is a read to confirm against, and off when the source has
                         moved: typing the tier's name is the act of confirming, and there is nothing
                         left here to confirm. -->
                    <TextBox Style="{StaticResource TextBox.Inline}" Width="150"
                             IsEnabled="{Binding CanConfirm, FallbackValue=False}"
                             Text="{Binding ConfirmText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- The push's own reports, in the order they happened: the new version's number, the
             read-back verification, anything that went wrong after the write landed. -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0"
                DataContext="{Binding Push}"
                Visibility="{Binding Notes.Count, Converter={StaticResource NotEmptyVis}, FallbackValue=Collapsed}">
            <ItemsControl ItemsSource="{Binding Notes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <ContentControl DockPanel.Dock="Bottom" Style="{StaticResource Notice.Danger}" Margin="0,10,0,0"
                        DataContext="{Binding Push}"
                        Visibility="{Binding Problem, Converter={StaticResource NotEmptyVis}, FallbackValue=Collapsed}">
            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource Brush.Danger}"
                       FontSize="12" TextWrapping="Wrap" />
        </ContentControl>

        <ContentControl DockPanel.Dock="Bottom" Style="{StaticResource Notice.Warn}" Margin="0,10,0,0"
                        Visibility="{Binding Warnings.Count, Converter={StaticResource NotEmptyVis}}">
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Shape}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="110" />
                <RowDefinition Height="10" />
                <RowDefinition Height="1.5*" MinHeight="140" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card.Flush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}">
                        <TextBlock Text="QUEUED CHANGES" Style="{StaticResource Text.SectionLabel}" />
                    </Border>

                    <DataGrid ItemsSource="{Binding Changes}" RowHeight="30">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="KEY" Binding="{Binding Path}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="ToolTip" Value="{Binding Path}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="WHAT" Binding="{Binding KindName}" Width="66" />

                            <DataGridTextColumn Header="CLASS" Binding="{Binding ClassName}" Width="66">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.ByClass}" />
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="FROM" Binding="{Binding BaseDisplay}" Width="200">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="ToolTip" Value="{Binding BaseDisplay}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="TO" Binding="{Binding NewDisplay}" Width="240">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                        <Setter Property="ToolTip" Value="{Binding NewDisplay}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Header="" Width="74">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Button.Small}" Content="Discard"
                                                Command="{Binding DataContext.DiscardCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Rows" />

            <!-- The comparison. Laid out source | payload, the same way round as every other
                 two-sided view in the app: what is there now on the left, what would replace it on
                 the right. Scoped to the push; with nothing to push the card stays, empty. -->
            <Border Grid.Row="2" Style="{StaticResource Card.Flush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Content="Show unchanged lines"
                                      DataContext="{Binding Push}"
                                      IsChecked="{Binding ShowUnchanged, FallbackValue=False}" />
                            <TextBlock Text="WHAT THE PUSH WOULD CHANGE — AGAINST THE SOURCE AS IT IS NOW"
                                       Style="{StaticResource Text.SectionLabel}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <StackPanel DockPanel.Dock="Top" DataContext="{Binding Push}">
                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}"
                                   FontSize="12" TextWrapping="Wrap" Margin="12,8,12,0"
                                   Visibility="{Binding Message, Converter={StaticResource NotEmptyVis}, FallbackValue=Collapsed}" />
                        <Grid Margin="12,8,12,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LeftHeader}"
                                       Style="{StaticResource Text.SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding RightHeader}"
                                       Style="{StaticResource Text.SectionLabel}" />
                        </Grid>
                    </StackPanel>

                    <!-- DiffRow.Edit rather than DiffRow: what is being confirmed here is an edit
                         going out, so a modified line takes the same amber the editor gave it rather
                         than the blue that means "two tiers differ". -->
                    <ListBox Style="{StaticResource LineList}" DataContext="{Binding Push}"
                             ItemsSource="{Binding Lines}" Padding="4"
                             ItemTemplate="{StaticResource DiffRow.Edit}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
