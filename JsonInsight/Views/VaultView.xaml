<UserControl x:Class="JsonInsight.Views.VaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JsonInsight.ViewModels;assembly=JsonInsight.Presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:VaultVm}"
             mc:Ignorable="d">

    <!--
        One list, and nothing above it.

        There used to be two more cards here: shared Vault credentials, and an app-wide document that
        was appended to every row's root. Between them, answering "what does stage actually read, and
        as whom" meant reading three places and knowing which won. A row now carries its own address,
        token and whole secret path, so the answer is on the row.
    -->
    <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,4,0">

        <!--
            At least as tall as the tab, so the list is not a short block floating in a tall empty
            pane. The rows take whatever is left over and the notes sit at the bottom of the page;
            with more rows than fit, the card grows past the viewport and this scrolls as before.
        -->
        <Border Style="{StaticResource Card.Flush}" MinHeight="{Binding ViewportHeight, ElementName=Page}">
            <DockPanel>

                <!-- Heading -->
                <Border DockPanel.Dock="Top" Padding="12,10,12,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Border Style="{StaticResource Pill}" Margin="0,0,10,0"
                                    Background="{DynamicResource Brush.SurfaceAlt}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveSummary}" FontSize="12"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </Border>
                            <!-- What this tab holds, and whether the rest of the app has caught up
                                 with it. There is no Save button: an edit here writes itself. -->
                            <TextBlock Text="{Binding ApplyHint}" Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="330" />
                            <Button Style="{StaticResource Button.Secondary}" Content="Reload settings"
                                    Command="{Binding ReloadSettingsCommand}" Margin="0,0,8,0"
                                    ToolTip="Re-read appsettings.json and user secrets into these rows — for when they have been changed outside this app. Nothing here is unsaved: the tab writes itself as you edit it." />
                            <!-- ShowOnDisabled, because off is this button's ordinary state: it says
                                 there is nothing to apply, and the tooltip is where it says which of
                                 the two reasons it is. -->
                            <Button Style="{StaticResource Button.Primary}" Content="Apply"
                                    Command="{Binding ApplyCommand}"
                                    ToolTipService.ShowOnDisabled="True"
                                    ToolTip="{Binding ApplyTooltip}" />
                        </StackPanel>
                        <TextBlock Text="SOURCES" Style="{StaticResource Text.SectionLabel}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="0.85*" />
                            <ColumnDefinition Width="3.65*" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="46" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ON" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Grid.Column="1" Text="ENV" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Grid.Column="2" Text="KIND" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Grid.Column="3" Text="VAULT ADDRESS" Style="{StaticResource Text.SectionLabel}" />
                        <TextBlock Grid.Column="4" Text="TOKEN" Style="{StaticResource Text.SectionLabel}" />
                        <!-- Over the path box, not the Search button that leads the same column:
                             the header names the field, and the button already names itself. The
                             margin is the button's pinned MinWidth plus its 8px gap. -->
                        <TextBlock Grid.Column="5" Text="JSON PATH" Style="{StaticResource Text.SectionLabel}"
                                   Margin="112,0,0,0" />
                    </Grid>
                </Border>

                <!--
                    Under the rows rather than over them. What this tab is for is answered by the
                    list itself; the paragraph explaining it is worth having but is not worth the
                    top of the page, and the status line reports on something you have just done -
                    which is where you were already looking by the time it appears.
                -->
                <Border DockPanel.Dock="Bottom" Padding="12,10,12,12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Problems}" Margin="0,0,0,6"
                                      Visibility="{Binding Problems.Count, Converter={StaticResource NotEmptyVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Missing}"
                                               TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The duplicate-source complaint. Red, and its own line rather than a
                             Status write: it is what disables Apply and holds the write back, and it
                             stays for as long as the clash exists instead of scrolling away under
                             the next report. -->
                        <TextBlock Text="{Binding DuplicateError}" Style="{StaticResource Text.Missing}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding DuplicateError, Converter={StaticResource NotEmptyVis}}" />

                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding Status, Converter={StaticResource NotEmptyVis}}" />

                        <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                                   Text="The environments this app knows, whether or not each has a source yet. A source is either a Vault secret — the whole path to one JSON, with its own address and token — or a single JSON file on disk. Press Search on a Vault row to walk that row's own server and list the JSONs actually there. Test reads what a row points at and reports what is there; it is what turns Load on, and any edit to the row turns Load off again. Tick ON to make a row one of the columns the other tabs compare; four at a time. Until something is ticked and saved, config/tiers.json decides that instead." />
                    </StackPanel>
                </Border>

                <!-- No scrollbar of its own: the page scrolls, and a nested one here would take the
                     rows away from the outer scroll and hide them a second time. -->
                <ScrollViewer VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.BorderSubtle}"
                                        BorderThickness="0,0,0,1" Padding="12,10">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="0.85*" />
                                                <ColumnDefinition Width="3.65*" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="62" />
                                                <ColumnDefinition Width="46" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Disabled on a row whose id is not one of the
                                                 predefined environments: the comparison is keyed by
                                                 those names, so ticking one that is not among them
                                                 could only ever be undone by SourceCatalog later. -->
                                            <CheckBox Grid.Column="0" IsChecked="{Binding Active}"
                                                      IsEnabled="{Binding CanActivate}"
                                                      VerticalAlignment="Center"
                                                      ToolTip="Compare this source. Four at a time - a fifth is refused with a note rather than silently dropped. The tick is saved as you make it; press Apply to rebuild the other tabs around it." />

                                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                                       Style="{StaticResource Text.Base}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <ComboBox Grid.Column="2" Margin="0,0,8,0"
                                                      ItemsSource="{Binding DataContext.Kinds, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      DisplayMemberPath="Label" SelectedValuePath="Kind"
                                                      SelectedValue="{Binding Kind, Mode=TwoWay}"
                                                      ToolTip="Where this environment's JSON lives - a Vault secret, or one JSON file on disk." />

                                            <DockPanel Grid.Column="3" Margin="0,0,8,0"
                                                       Visibility="{Binding IsVault, Converter={StaticResource BoolVis}}">
                                                <!-- On the row, not only in the menu. Certificate
                                                     checking being off is a property of this
                                                     connection worth seeing without opening
                                                     anything: a setting you cannot see is one you
                                                     forget you turned on. -->
                                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}"
                                                        Margin="6,0,0,0" Padding="7,1"
                                                        Background="{DynamicResource Brush.ShapeSoft}"
                                                        Visibility="{Binding AllowInsecureTls, Converter={StaticResource BoolVis}}"
                                                        ToolTip="Certificate checking is off for this row. Change it in the row's More menu.">
                                                    <TextBlock Text="TLS off" FontSize="10" FontWeight="Bold"
                                                               Foreground="{DynamicResource Brush.Shape}" />
                                                </Border>

                                                <!-- Focus selects the whole address: the usual edit
                                                     is replacing one server with another, not
                                                     appending to it. -->
                                                <TextBox Style="{StaticResource TextBox.Inline}"
                                                         Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                                         GotKeyboardFocus="OnAddressGotFocus"
                                                         PreviewMouseLeftButtonDown="OnAddressMouseDown"
                                                         ToolTip="This row's Vault, e.g. https://vault.example.com:8200. Each row carries its own, so two environments can live on different servers." />
                                            </DockPanel>

                                            <PasswordBox Grid.Column="4" Margin="0,0,8,0"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsVault, Converter={StaticResource BoolVis}}"
                                                         Loaded="TokenBox_Sync" DataContextChanged="TokenBox_DataContextChanged"
                                                         PasswordChanged="TokenBox_PasswordChanged"
                                                         ToolTip="This row's token. Stored in user secrets only - never in appsettings.json." />

                                            <!-- The path and the button that fills it, together: the
                                                 list Search returns is this field's contents, so
                                                 putting them apart would separate a control from the
                                                 only thing that changes it. Search leads, because it
                                                 is what turns an empty box into a list to choose
                                                 from. -->
                                            <DockPanel Grid.Column="5" Margin="0,0,8,0"
                                                       Visibility="{Binding IsVault, Converter={StaticResource BoolVis}}">
                                                <!-- MinWidth pins where the path box starts, which is
                                                     what lets the JSON PATH header sit over the box:
                                                     a header aligned to a button whose width follows
                                                     its text would drift. -->
                                                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}"
                                                        Margin="0,0,8,0" Height="{StaticResource Size.Control}"
                                                        MinWidth="104"
                                                        Command="{Binding DataContext.SearchVaultCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        IsEnabled="{Binding Searching, Converter={StaticResource NotBool}}"
                                                        ToolTip="Walk this row's Vault and list every secret it holds, so the JSON can be picked rather than remembered. Metadata only - no value is read and nothing is written.">
                                                    <!-- Two blocks rather than one string: the glyph
                                                         needs the icon font and the word must not
                                                         have it, and one TextBlock cannot be both.
                                                         As one string the glyph fell back to a
                                                         tofu box. -->
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE721;" FontSize="13"
                                                                   FontFamily="{StaticResource Font.Icons}"
                                                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <TextBlock VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="Search" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Searching}" Value="True">
                                                                            <Setter Property="Text" Value="Searching&#8230;" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>

                                                <!-- Editable: the list is what Search found, and a
                                                     secret this token cannot list must still be
                                                     reachable by typing its path.

                                                     FilteredPaths rather than KnownPaths, so typing
                                                     narrows the open dropdown to matches. Text
                                                     search off because it fights that: it would
                                                     auto-complete to the first match and overwrite
                                                     what is being typed. Off while Search walks the
                                                     Vault — the list is being replaced under it. -->
                                                <ComboBox Style="{StaticResource ComboBox.Path}"
                                                          ItemsSource="{Binding FilteredPaths}"
                                                          IsTextSearchEnabled="False"
                                                          IsEnabled="{Binding Searching, Converter={StaticResource NotBool}}"
                                                          Text="{Binding SecretPath, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="The whole path to the JSON this row reads, e.g. kv/app/stage/resources/config/ui.json. Pick one Search found, or type to filter the list." />
                                            </DockPanel>

                                            <!-- A file needs no address or token, so it takes their
                                                 room rather than leaving two dead boxes on the row. -->
                                            <DockPanel Grid.Column="3" Grid.ColumnSpan="3" Margin="0,0,8,0"
                                                       Visibility="{Binding IsLocalFile, Converter={StaticResource BoolVis}}">
                                                <!-- Leading, where a Vault row has Search: the same
                                                     column doing the same job. -->
                                                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Secondary}"
                                                        Content="Browse&#8230;" Margin="0,0,8,0"
                                                        Height="{StaticResource Size.Control}" MinWidth="104"
                                                        Command="{Binding DataContext.BrowseLocalFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Pick the JSON file this environment reads and writes." />
                                                <TextBox Style="{StaticResource TextBox.Inline}"
                                                         Text="{Binding LocalFilePath, UpdateSourceTrigger=PropertyChanged}"
                                                         ToolTip="The JSON file this environment is. Saving to it backs up the previous content beside it first, then writes and reads back to verify." />
                                            </DockPanel>

                                            <!-- Test then Load, in that order and in that dependency:
                                                 Test is the only thing that turns Load on, and any
                                                 edit to the row turns it off again. It came out of
                                                 the ⋮ menu to sit here because a button you have to
                                                 press before the next one works is not an
                                                 occasional option.

                                                 Height is set rather than left to MinHeight: the
                                                 Search button beside these holds an icon and a word,
                                                 which measures taller than a button holding a word,
                                                 so the two sat at different heights on the same row. -->
                                            <Button Grid.Column="6" Style="{StaticResource Button.Secondary}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"
                                                    Height="{StaticResource Size.Control}" Padding="10,0"
                                                    Content="Test"
                                                    Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanTest}"
                                                    ToolTip="Test connection - reads what this row points at and reports what is there: a Vault secret's version and key count, a file's key count and details. Keeps nothing and changes nothing on the other tabs. Load turns on once this succeeds. Off until the row says where to read from." />

                                            <!-- Pull reads all four sources; this reads the one
                                                 whose path was just fixed, and afterwards the other
                                                 tabs are showing it - which is what Pull was being
                                                 pressed for. -->
                                            <Button Grid.Column="7" Style="{StaticResource Button.Primary}"
                                                    VerticalAlignment="Center"
                                                    Height="{StaticResource Size.Control}" Padding="10,0"
                                                    Command="{Binding DataContext.LoadRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding CanLoad}"
                                                    ToolTip="Read this source now and show it on the Tier editor, All tiers and Text diff. Pull in the title bar does all of them; this does one. Off until Test has read this source, and off again after any edit to the row.">
                                                <TextBlock VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Load" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Busy}" Value="True">
                                                                    <Setter Property="Text" Value="Loading&#8230;" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>

                                            <!-- What is left is Vault-only and occasional: a TLS
                                                 exception set once, an endpoint configured once, and
                                                 a restart that should never be one click from a row
                                                 of environments that all look alike. A local-file
                                                 row has no certificate to trust and nothing running
                                                 behind it to restart, so it gets no menu rather than
                                                 an empty one. Call restart stays separate from
                                                 Restart config inside the menu for the same reason
                                                 it always was - one is a configuration act and the
                                                 other is destructive. -->
                                            <Button Grid.Column="8" Style="{StaticResource Button.Secondary}"
                                                    VerticalAlignment="Center" HorizontalAlignment="Right"
                                                    Height="{StaticResource Size.Control}"
                                                    Padding="8,0" MinWidth="0"
                                                    Visibility="{Binding IsVault, Converter={StaticResource BoolVis}}"
                                                    Click="OnRowMenuClick"
                                                    ToolTip="More options for this source.">
                                                <TextBlock Text="&#xE712;" FontFamily="{StaticResource Font.Icons}"
                                                           FontSize="14" VerticalAlignment="Center" />
                                                <Button.ContextMenu>
                                                    <!-- DataContext is set in OnRowMenuClick: a
                                                         ContextMenu lives in its own visual tree, so
                                                         it does not inherit the row's and every
                                                         binding below would silently bind to nothing. -->
                                                    <ContextMenu>
                                                        <!-- Mode=TwoWay is required: unlike
                                                             CheckBox.IsChecked, MenuItem.IsChecked
                                                             does not bind two-way by default, so
                                                             without it the tick would show the
                                                             stored value and never write one back.

                                                             The header says the state in words as
                                                             well as by its tick - a lone tick beside
                                                             "Insecure TLS" required knowing that
                                                             ticked meant checking was off. -->
                                                        <MenuItem IsCheckable="True"
                                                                  IsChecked="{Binding AllowInsecureTls, Mode=TwoWay}"
                                                                  ToolTip="Accept any certificate from this row's Vault. Only for an internal server behind a self-signed cert.">
                                                            <MenuItem.Style>
                                                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                                                    <Setter Property="Header" Value="Insecure TLS  —  OFF" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding AllowInsecureTls}" Value="True">
                                                                            <Setter Property="Header" Value="Insecure TLS  —  ON" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </MenuItem.Style>
                                                        </MenuItem>

                                                        <Separator />

                                                        <MenuItem Header="Restart config&#8230;" Click="OnRestartConfigClick"
                                                                  ToolTip="Set the endpoint that restarts whatever reads this source. Saved with the row; the bearer token is not." />

                                                        <MenuItem Header="Call restart&#8230;" Click="OnRestartCallClick"
                                                                  ToolTip="{Binding RestartSummary}"
                                                                  IsEnabled="{Binding HasRestart}" />
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>

                                        <!-- Red for a test or load that failed, the neutral grey for
                                             everything else — "Reading…", "Loaded", the how-to
                                             hints. One line either way; only the colour says which
                                             kind of news it is. -->
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="38,6,0,0"
                                                   Visibility="{Binding Status, Converter={StaticResource NotEmptyVis}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </ScrollViewer>
</UserControl>
