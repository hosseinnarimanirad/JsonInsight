<Window x:Class="JsonInsight.Views.EditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JsonInsight.ViewModels;assembly=JsonInsight.Presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:EditVm}"
        mc:Ignorable="d"
        Title="Edit" Height="720" Width="1180"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        FontFamily="{StaticResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text}"
        Background="{DynamicResource Brush.Window}">

    <Window.Resources>
        <ObjectDataProvider x:Key="RowActions" MethodName="GetValues" ObjectType="{x:Type sys:Enum}"
                            xmlns:sys="clr-namespace:System;assembly=System.Runtime">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="vm:RowAction" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Heading}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Caption}"
                           Margin="0,3,0,0" TextWrapping="Wrap" />

                <!-- The batch affordance. One value typed once, applied to every row. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Set every row to" Style="{StaticResource Text.Base}"
                               VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBox Style="{StaticResource TextBox.Inline}" Width="440"
                             Text="{Binding BulkValue, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox ItemsSource="{Binding Source={x:Static vm:EditVm.KindOptions}}"
                              SelectedValue="{Binding BulkKind}" SelectedValuePath="Kind"
                              DisplayMemberPath="Label" Width="104" Margin="8,0,0,0"
                              VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Secondary}" Content="Apply to all"
                            Command="{Binding ApplyToAllCommand}" Margin="8,0,0,0"
                            VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Small}" Content="Delete in all"
                            Command="{Binding DeleteAllCommand}" Margin="14,0,0,0"
                            VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Small}" Content="Keep all"
                            Command="{Binding KeepAllCommand}" Margin="6,0,0,0"
                            VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}"
                        Content="Apply these changes" MinWidth="170"
                        Command="{Binding QueueCommand}" IsEnabled="{Binding CanQueue}"
                        Margin="8,0,0,0"
                        ToolTip="Changes what the app is holding, which is what every tab then shows. Nothing is written to a source until you push." />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Close"
                        MinWidth="100" Click="OnCloseClick" />

                <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Secondary}"
                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                           Margin="0,0,14,0" />
            </DockPanel>
        </Border>

        <!-- Warnings. These are the whole reason adding a key is not just a text box: a path that
             exists nowhere is indistinguishable from a typo, and the Vault loader has no fallback. -->
        <ContentControl DockPanel.Dock="Bottom" Style="{StaticResource Notice.Warn}" Margin="0,10,0,0"
                        Visibility="{Binding Warnings.Count, Converter={StaticResource NotEmptyVis}}">
            <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource Brush.Shape}"
                                   FontSize="12" TextWrapping="Wrap" Margin="0,1" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>

        <Border Style="{StaticResource Card.Flush}">
            <DockPanel>
                <Border DockPanel.Dock="Top" Style="{StaticResource TableHeader}">
                    <TextBlock Text="ONE ROW PER KEY PER TIER" Style="{StaticResource Text.SectionLabel}" />
                </Border>

                <DataGrid ItemsSource="{Binding Rows}" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="KEY" Binding="{Binding Path}" Width="2*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                    <Setter Property="ToolTip" Value="{Binding Path}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="TIER" Binding="{Binding TierId}" Width="64">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="CLASS" Binding="{Binding ClassName}" Width="66">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.ByClass}" />
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="NOW" Binding="{Binding CurrentDisplay}" Width="1.4*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                                    <Setter Property="ToolTip" Value="{Binding CurrentDisplay}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="ACTION" Width="106">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Source={StaticResource} rather than the provider directly:
                                         an ObjectDataProvider assigned straight to ItemsSource throws
                                         when the row is realised. Same reason as the promote dialog. -->
                                    <ComboBox ItemsSource="{Binding Source={StaticResource RowActions}}"
                                              SelectedItem="{Binding Action, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsEditable}"
                                              Margin="0,2" VerticalAlignment="Center"
                                              ToolTip="{Binding NotEditableReason}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="NEW VALUE" Width="1.8*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Style="{StaticResource TextBox.Inline}" Margin="0,2"
                                             IsEnabled="{Binding IsEditable}"
                                             Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="TYPE" Width="98">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Source={x:Static vm:EditVm.KindOptions}}"
                                              SelectedValue="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                              SelectedValuePath="Kind" DisplayMemberPath="Label"
                                              IsEnabled="{Binding IsEditable}"
                                              Margin="0,2" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
