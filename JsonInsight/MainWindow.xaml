<Window x:Class="JsonInsight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:JsonInsight.Views"
        xmlns:vm="clr-namespace:JsonInsight.ViewModels;assembly=JsonInsight.Presentation"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        d:DataContext="{d:DesignInstance Type=vm:MainVm}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="900" Width="1580" MinHeight="600" MinWidth="1040"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource Font.Ui}"
        Foreground="{DynamicResource Brush.Text}"
        Background="{DynamicResource Brush.Window}">

    <Window.InputBindings>
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding ToggleThemeCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================== Header ============================== -->
        <Border Grid.Row="0" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.Accent}">
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}" FontSize="17"
                                   Foreground="{DynamicResource Brush.OnAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="JsonInsight" Style="{StaticResource Text.Heading}"
                                       VerticalAlignment="Center" />

                            <!-- The project beside the app's name, not instead of it. A project here
                                 is often named after a file - config.json, content.json - so putting
                                 one where the title goes reads as the app having been renamed to a
                                 file. This says what JsonInsight is open on. -->
                            <Border Style="{StaticResource Pill}" Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource Brush.AccentSoft}"
                                    Visibility="{Binding HasProjectOpen, Converter={StaticResource BoolVis}}"
                                    ToolTip="The project that is open. Press Projects to switch.">
                                <TextBlock Text="{Binding ProjectChip}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="260" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding DocumentCaption}" Style="{StaticResource Text.Caption}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="520"
                                   ToolTip="What this project compares, and how many of its sources loaded." />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The way back to the project list, and the only sign on this bar that there is
                         more than one project. It is not a dropdown: switching project changes which
                         secrets get read, which is a screen's worth of decision rather than a menu's. -->
                    <Button Style="{StaticResource Button.Secondary}" Margin="0,0,10,0"
                            Command="{Binding ShowProjectListCommand}"
                            Visibility="{Binding ShowingProjectList, Converter={StaticResource BoolVis}, ConverterParameter=invert}"
                            ToolTip="Switch project, or create one. Nothing here is closed by looking — the tiers, the queued edits and the tab you are on are all still here when you come back.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Projects" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Only when there is something to go back to: with no project open, the list is
                         not covering anything. -->
                    <Button Margin="0,0,10,0"
                            Command="{Binding BackToProjectCommand}"
                            ToolTip="Back to the project you were in. Nothing was closed.">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding ShowingProjects}" Value="True" />
                                            <Condition Binding="{Binding HasProjectOpen}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Back to" /><Run Text=" " /><Run Text="{Binding ActiveProject, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Icon}" Content="{Binding ThemeGlyph}"
                            Margin="0,0,10,0"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="{Binding ThemeTooltip}" />

                    <!-- The two refreshes, side by side because the difference between them is the
                         thing worth seeing: this one re-reads the tiers, the next also re-reads the
                         config files and rebuilds every tab. -->
                    <!-- Disabled and spinning while a read is in flight, the startup one included: a
                         button that still looks pressable during a network call is a button that
                         gets pressed again, and the read nobody asked for is the one that most needs
                         to say it is happening. -->
                    <!-- Off, too, while an environment ticked ON names no source. There is no reading
                         around that one: what a pull would produce is a comparison missing the column
                         somebody just asked for, arriving looking exactly like a successful one. The
                         tooltip carries the reason, and shows while disabled — which is when it is
                         asked for. -->
                    <Button Style="{StaticResource Button.Primary}" Margin="0,0,8,0"
                            Command="{Binding Tiers.PullFromVaultCommand}"
                            IsEnabled="{Binding CanPull}"
                            ToolTipService.ShowOnDisabled="True"
                            Visibility="{Binding ShowingProjectList, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                        <Button.ToolTip>
                            <ToolTip>
                                <TextBlock TextWrapping="Wrap" MaxWidth="420">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Read every configured tier again, from Vault or from disk — every one that has a source, not only the ones being compared. Nothing is written: a pull replaces what is in memory, and what is in memory is all there is. The per-tier result is listed on the All tiers tab." />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PullBlocked, Converter={StaticResource NotEmptyVis}}" Value="Visible">
                                                    <Setter Property="Text" Value="{Binding PullBlocked}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ToolTip>
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE896;" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VaultBusy}" Value="True">
                                                <!-- The refresh arrows, turning. A glyph that moves
                                                     says "in progress" without a word beside it. -->
                                                <Setter Property="Text" Value="&#xE72C;" />
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard x:Name="Spin">
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                From="0" To="360" Duration="0:0:1.1"
                                                                RepeatBehavior="Forever" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                                <DataTrigger.ExitActions>
                                                    <StopStoryboard BeginStoryboardName="Spin" />
                                                </DataTrigger.ExitActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Pull from Vault or disk" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VaultBusy}" Value="True">
                                                <Setter Property="Text" Value="Pulling…" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== Content ============================= -->
        <DockPanel Grid.Row="1" Margin="14,12,14,0">

            <!-- These values are only as current as the last pull, whether that read a Vault secret
                 or a file on disk, and they hold live credentials. Both facts are easy to forget
                 after five minutes of reading a diff. -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Notice.Warn}" Margin="0,0,0,10"
                    Visibility="{Binding ShowingProjectList, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Font.Icons}" FontSize="13"
                               Foreground="{DynamicResource Brush.Shape}" VerticalAlignment="Top"
                               Margin="0,1,9,0" />
                    <TextBlock Style="{StaticResource Text.Base}" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Shape}" FontSize="12"
                               Text="These values are only as fresh as the last pull from Vault or disk, and they hold live credentials — re-read before trusting a value, and never paste one into a report." />
                </StackPanel>
            </Border>

            <!-- Where the tiers on screen came from, said whether or not anything went wrong.
                 Reporting only failures left "it worked" indistinguishable from "nothing has
                 happened yet", and made the only Vault message anyone ever saw a red one at
                 startup, about a read they had not asked for. -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,10" CornerRadius="9" Padding="12,8"
                    Visibility="{Binding VaultNote, Converter={StaticResource NotEmptyVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush.ShapeSoft}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VaultNoteIsGood}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush.OkSoft}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,9,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE7BA;" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Shape}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VaultNoteIsGood}" Value="True">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="{Binding VaultNote}" FontSize="12" TextWrapping="Wrap"
                               VerticalAlignment="Center" MaxWidth="1150">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Base}">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Shape}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VaultNoteIsGood}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Findings used to be a banner here. They are on the Logs tab now: a banner is the
                 right shape for one urgent sentence and the wrong one for a list that grows per
                 source, and its only control was Dismiss - so the choice was between losing the
                 window and losing the findings. See LogVm. -->

            <!-- Named for what you go there to do, not for the format involved: three of these
                 read JSON, so "JSON compare" beside "Raw diff" said nothing about which one
                 answers the question you actually have. -->
            <!-- The projects screen stands in for the tabs rather than sitting beside them: with no
                 project open there are no sources to compare, so every tab would be an empty grid
                 with no way to explain itself.

                 Both live in one Grid cell, on top of each other, rather than as two DockPanel
                 children. An undocked DockPanel child docks Left, so the screen that is showing would
                 take its natural width and leave the rest of the window empty; in a single-cell Grid
                 whichever one is visible fills. -->
            <Grid>
            <views:ProjectsView DataContext="{Binding Projects}"
                                Visibility="{Binding DataContext.ShowingProjectList, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}" />

            <TabControl Visibility="{Binding ShowingProjectList, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <TabItem Header="Tier editor" ToolTip="Edit one tier's document as JSON, a node at a time.">
                    <views:JsonEditorView x:Name="Editor" DataContext="{Binding JsonEditor}" />
                </TabItem>
                <TabItem Header="All tiers" ToolTip="Every tier side by side, key by key. Where promoting and batch editing start.">
                    <views:TiersView x:Name="Tiers" DataContext="{Binding Tiers}" />
                </TabItem>
                <TabItem Header="Text diff" ToolTip="Two tiers as text, line by line — the view that shows ordering and formatting.">
                    <views:RawDiffView DataContext="{Binding RawDiff}" />
                </TabItem>
                <TabItem Header="Compare files" ToolTip="Key by key against any two JSON files on disk, not only the configured tiers.">
                    <views:JsonCompareView DataContext="{Binding JsonCompare}" />
                </TabItem>
                <TabItem Header="Sources" ToolTip="Where each environment's JSON comes from — a Vault secret or a file on disk — which of them are being compared, and the credentials used to read them.">
                    <views:VaultView x:Name="Sources" DataContext="{Binding Vault}" />
                </TabItem>
                <TabItem ToolTip="Everything the app has said — warnings, read failures and status, newest first.">
                    <TabItem.Header>
                        <!-- The findings no longer have a banner shouting them, so the tab carries
                             the count instead; without it a failed read would be silent. -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Logs" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Pill}" Margin="6,0,0,0" Padding="6,0"
                                    Background="{DynamicResource Brush.DangerSoft}"
                                    Visibility="{Binding DataContext.Log.HasProblems,
                                                         RelativeSource={RelativeSource AncestorType=Window},
                                                         Converter={StaticResource BoolVis}}">
                                <TextBlock FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Danger}"
                                           Text="{Binding DataContext.Log.Badge,
                                                          RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Border>
                        </StackPanel>
                    </TabItem.Header>
                    <views:LogsView DataContext="{Binding Log}" />
                </TabItem>
            </TabControl>
            </Grid>
        </DockPanel>

        <!-- ============================= Status bar =========================== -->
        <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.BorderSubtle}" BorderThickness="0,1,0,0"
                Margin="0,12,0,0">
            <Grid Margin="18,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Status}" Style="{StaticResource Text.Secondary}"
                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="1" Text="{Binding ContentRoot}" Style="{StaticResource Text.Caption}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="520" />
            </Grid>
        </Border>
    </Grid>
</Window>
